# DailyUse 共享基础配置
# =============================================================================
# 此文件包含所有环境共享的默认值
# 会被 .env.{NODE_ENV} 和 .env.local 覆盖
# =============================================================================

# 时区
TZ=Asia/Shanghai

# 默认端口
API_PORT=3000
API_HOST=0.0.0.0

# JWT 过期时间（默认值）
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Redis 默认配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 文件上传限制（10MB）
UPLOAD_MAX_SIZE=10485760

# 功能开关默认值
ENABLE_DAILY_ANALYSIS=true
USE_PRIORITY_QUEUE_SCHEDULER=true

DATABASE_URL="postgresql://neondb_owner:npg_EMRDslI5oC2S@ep-dry-bar-a18hfly2-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Merged from apps/api/.env
PORT=3888

# Local PostgreSQL Database (use 127.0.0.1 to avoid Windows Docker IPv6 resolution issues)
# DATABASE_URL="postgresql://dailyuse:dailyuse123@127.0.0.1:5432/dailyuse"

# Redis Cache
# Using Upstash (cloud Redis) - prefer serving from REDIS_URL
# Example CLI (commented): redis-cli --tls -u redis://default:AU5kAAIncDI4MDcwYTg1NjU1OWI0MzExOTIzY2Y2NWNmOWYxYTRmOXAyMjAwNjg@logical-ox-20068.upstash.io:6379
# Commenting out local host-based configuration to avoid accidental local connections
# REDIS_HOST=localhost
# REDIS_PORT=6384
# REDIS_PASSWORD=dailyuse123
# REDIS_DB=0

# Upstash connection (supports TLS) - use rediss:// to enable TLS with ioredis
REDIS_URL="rediss://default:AU5kAAIncDI4MDcwYTg1NjU1OWI0MzExOTIzY2Y2NWNmOWYxYTRmOXAyMjAwNjg@logical-ox-20068.upstash.io:6379"

# CORS - Development allows all origins (production should set specific domains)
CORS_ORIGIN=*

# JWT Secrets (development)
JWT_SECRET=dev-secret-key-change-in-production
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-in-production

# QI Niu Yun Configuration
QI_NIU_YUN_API_KEY=sk-e265538bbbeaf55e705c170302ce52332baa503f0bd44e0ccd5eae9a0093d0bf
QI_NIU_YUN_BASE_URL=https://openai.qiniu.com/v1
QI_NIU_YUN_BASE_URL_BACKUP=https://api.qnaigc.com/v1
QI_NIU_YUN_MODEL_ID=deepseek-v3
QI_NIU_YUN_AK=h_eaZRDnY5jTSzTa85OxAnWFrxkYINA2OkK00klq
QI_NIU_YUN_SK=5DEVrBzwB8jQ05ynq2004TUJPfz4M20ILqSNqwfv

# Merged from apps/web/.env
VITE_APP_NAME=DailyUse Web
VITE_LOG_LEVEL=info
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEVTOOLS=false

# Merged from packages/governance/.env
GOVERNANCE_DATABASE_URL="file:./governance.db"