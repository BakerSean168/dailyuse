{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "incremental": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      // ✅ 核心基础设施包
      "@dailyuse/database": ["packages/database/src/index.ts"],
      "@dailyuse/database/*": ["packages/database/src/*/index.ts"],
      "@dailyuse/patterns": ["packages/patterns/src/index.ts"],
      "@dailyuse/utils": ["packages/utils/src/index.ts"],
      "@dailyuse/utils/*": ["packages/utils/src/*/index.ts"],
      "@dailyuse/contracts": ["packages/contracts/src/index.ts"],
      "@dailyuse/contracts/*": ["packages/contracts/src/*/index.ts"],
      "@dailyuse/assets": ["packages/assets/src/index.ts"],
      
      // ✅ 领域层包（分层架构）
      "@dailyuse/domain-shared": ["packages/domain-shared/src/index.ts"],
      "@dailyuse/domain-shared/*": ["packages/domain-shared/src/*/index.ts"],
      "@dailyuse/domain-server": ["packages/domain-server/src/index.ts"],
      "@dailyuse/domain-server/*": ["packages/domain-server/src/*/index.ts"],
      "@dailyuse/domain-client": ["packages/domain-client/src/index.ts"],
      "@dailyuse/domain-client/*": ["packages/domain-client/src/*/index.ts"],
      
      // ✅ 应用层包
      "@dailyuse/application-server": ["packages/application-server/src/index.ts"],
      "@dailyuse/application-server/*": ["packages/application-server/src/*/index.ts"],
      "@dailyuse/application-client": ["packages/application-client/src/index.ts"],
      "@dailyuse/application-client/*": ["packages/application-client/src/*/index.ts"],
      
      // ✅ 基础设施层包
      "@dailyuse/infrastructure-server": ["packages/infrastructure-server/src/index.ts"],
      "@dailyuse/infrastructure-server/*": ["packages/infrastructure-server/src/*/index.ts"],
      "@dailyuse/infrastructure-client": ["packages/infrastructure-client/src/index.ts"],
      "@dailyuse/infrastructure-client/*": ["packages/infrastructure-client/src/*/index.ts"],
      
      // ✅ 业务模块包
      "@dailyuse/governance": ["packages/governance/src/index.ts"],
      "@dailyuse/governance/*": ["packages/governance/src/*/index.ts"],
      "@dailyuse/account": ["packages/account/src/index.ts"],
      "@dailyuse/account/*": ["packages/account/src/*/index.ts"],
      "@dailyuse/authentication": ["packages/authentication/src/index.ts"],
      "@dailyuse/authentication/*": ["packages/authentication/src/*/index.ts"],
      
      // ✅ 客户端工具包
      "@dailyuse/http-client": ["packages/http-client/src/index.ts"],
      "@dailyuse/ipc-client": ["packages/ipc-client/src/index.ts"],
      "@dailyuse/sync-client": ["packages/sync-client/src/index.ts"],
      
      // ✅ UI 组件包
      "@dailyuse/ui-core": ["packages/ui-core/src/index.ts"],
      "@dailyuse/ui-react": ["packages/ui-react/src/index.ts"],
      "@dailyuse/ui-vue": ["packages/ui-vue/src/index.ts"],
      "@dailyuse/ui-shadcn": ["packages/ui-shadcn/src/index.ts"],
      "@dailyuse/ui-vuetify": ["packages/ui-vuetify/src/index.ts"],
      
      // ✅ 调度服务包
      "@dailyuse/scheduler-server": ["packages/scheduler-server/src/index.ts"],
      
      // ✅ 测试工具
      "@dailyuse/test-utils": ["packages/test-utils/src/index.ts"],
      
      // ✅ API 内部路径
      "@api/shared": ["apps/api/src/shared/index.ts"]
    }
  }
}
