{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "incremental": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      // ✅ 核心基础设施包
      "@dailyuse/database": ["packages/database/src/index.ts"],
      "@dailyuse/database/*": ["packages/database/src/*/index.ts"],
      "@dailyuse/patterns": ["packages/patterns/src/index.ts"],
      "@dailyuse/utils": ["packages/utils/src/index.ts"],
      "@dailyuse/utils/*": ["packages/utils/src/*/index.ts", "packages/utils/src/*.ts"],
      "@dailyuse/contracts": ["packages/contracts/src/index.ts"],
      "@dailyuse/contracts/notification": ["packages/contracts/src/modules/notification/index.ts"],
      "@dailyuse/contracts/*": [
        "packages/contracts/src/modules/*/index.ts",
        "packages/contracts/src/*/index.ts"
      ],
      "@dailyuse/contracts/modules/*": ["packages/contracts/src/modules/*/index.ts"],
      "@dailyuse/assets": ["packages/assets/src/index.ts"],
      "@dailyuse/assets/*": ["packages/assets/src/*/index.ts", "packages/assets/src/*.ts"],

      // ✅ 领域层包（分层架构）
      "@dailyuse/domain-shared": ["packages/domain-shared/src/index.ts"],
      "@dailyuse/domain-shared/*": ["packages/domain-shared/src/*/index.ts"],

      // ✅ 业务模块包
      "@dailyuse/governance": ["packages/governance/src/index.ts"],
      "@dailyuse/governance/*": ["packages/governance/src/*/index.ts"],
      "@dailyuse/account": ["packages/account/src/index.ts"],
      "@dailyuse/account/*": ["packages/account/src/*/index.ts"],
      "@dailyuse/authentication": ["packages/authentication/src/index.ts"],
      "@dailyuse/authentication/*": ["packages/authentication/src/*/index.ts"],
      "@dailyuse/goal": ["packages/goal/src/index.ts"],
      "@dailyuse/goal/*": ["packages/goal/src/*/index.ts"],
      "@dailyuse/task": ["packages/task/src/index.ts"],
      "@dailyuse/task/*": ["packages/task/src/*/index.ts"],
      "@dailyuse/repository": ["packages/repository/src/index.ts"],
      "@dailyuse/repository/*": ["packages/repository/src/*/index.ts"],
      "@dailyuse/editor": ["packages/editor/src/index.ts"],
      "@dailyuse/editor/*": ["packages/editor/src/*/index.ts"],
      "@dailyuse/reminder": ["packages/reminder/src/index.ts"],
      "@dailyuse/reminder/*": ["packages/reminder/src/*/index.ts"],
      "@dailyuse/notification": ["packages/notification/src/index.ts"],
      "@dailyuse/notification/*": ["packages/notification/src/*/index.ts"],
      "@dailyuse/schedule": ["packages/schedule/src/index.ts"],
      "@dailyuse/schedule/*": ["packages/schedule/src/*/index.ts"],
      "@dailyuse/setting": ["packages/setting/src/index.ts"],
      "@dailyuse/setting/*": ["packages/setting/src/*/index.ts"],
      "@dailyuse/ai": ["packages/ai/src/index.ts"],
      "@dailyuse/ai/*": ["packages/ai/src/*/index.ts"],

      // ✅ 客户端工具包
      "@dailyuse/http-client": ["packages/http-client/src/index.ts"],
      "@dailyuse/ipc-client": ["packages/ipc-client/src/index.ts"],

      // ✅ UI 组件包
      "@dailyuse/ui-core": ["packages/ui-core/src/index.ts"],
      "@dailyuse/ui-core/*": ["packages/ui-core/src/*", "packages/ui-core/src/*/index.ts"],
      "@dailyuse/ui-react-native": ["packages/ui-react-native/src/index.ts"],
      "@dailyuse/app-react": ["packages/app-react/src/index.ts"],
      "@dailyuse/app-vue": ["packages/app-vue/src/index.ts"],
      "@dailyuse/ui-vue-shadcn": ["packages/ui-vue-shadcn/src/index.ts"],
      "@dailyuse/ui-vue-shadcn/*": [
        "packages/ui-vue-shadcn/src/*",
        "packages/ui-vue-shadcn/src/*/index.ts"
      ],
      "@dailyuse/dashboard": ["packages/dashboard/src/index.ts"],
      "@dailyuse/dashboard/*": ["packages/dashboard/src/*/index.ts", "packages/dashboard/src/*.ts"],

      // ✅ 调度服务包
      "@dailyuse/scheduler-server": ["packages/scheduler-server/src/index.ts"],

      // ✅ 测试工具
      "@dailyuse/test-utils": ["packages/test-utils/src/index.ts"],

      // ✅ 本地 Nx plugin
      "@dailyuse/nx-test-system": ["tools/nx-test-system/index.js"],

      // ✅ API 内部路径
      "@api/shared": ["apps/api/src/shared/index.ts"]
    }
  }
}
