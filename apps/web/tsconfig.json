{
  // 继承基础配置
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // ============================================================
    // 路径和输出配置
    // ============================================================

    // 基础路径：相对路径的起点
    "baseUrl": ".",

    // 输出目录：编译后的文件
    "outDir": "./dist",

    // 生成输出文件
    "noEmit": true,

    // ============================================================
    // Composite 项目配置（Monorepo 关键）
    // ============================================================

    // 关闭 composite（统一改由 tsup 输出类型与产物）
    "composite": false,

    // Web 应用不需要生成类型声明文件（它不是库）
    "declaration": false,
    "declarationMap": false,

    // 生成 JavaScript 的 source map（调试支持）
    "sourceMap": true,

    // ============================================================
    // 浏览器 + Vite 环境配置
    // ============================================================

    // 标准库：包含 ES2020 和浏览器 DOM API
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    // 类型定义：包含 Vite 客户端类型（如 import.meta.env）
    "types": ["node", "vite/client"],

    // 模块解析：使用 Bundler 策略（适配 Vite）
    // Bundler 策略会处理：
    // 1. 导入非 JavaScript 文件（.vue, .css, .svg 等）
    // 2. 路径别名（由 vite.config.ts 配置）
    // 3. package.json 的 exports 字段
    "moduleResolution": "Bundler",

    // ============================================================
    // 本地路径别名配置
    // ============================================================

    // 路径别名
    "paths": {
      // 项目内部别名：@/ 指向 src 目录
      "@/components/ui/*": ["../../packages/ui-vue-shadcn/src/components/ui/*/index.ts"],
      "@/lib/*": ["../../packages/ui-vue-shadcn/src/lib/*"],
      "@/*": ["./src/*"],

      // ✅ 开发态源码白名单：仅保留当前需要深度联调的 workspace 包
      "@dailyuse/app-vue/web-core": ["../../packages/app-vue/src/web-core.ts"],
      "@dailyuse/app-vue/web-shell-core": ["../../packages/app-vue/src/web-shell-core.ts"],
      "@dailyuse/app-vue/web-overlays": ["../../packages/app-vue/src/web-overlays.ts"],
      "@dailyuse/app-vue/web-shell": ["../../packages/app-vue/src/web-shell.ts"],
      "@dailyuse/app-vue/web-i18n": ["../../packages/app-vue/src/web-i18n.ts"],
      "@dailyuse/app-vue/web-bootstrap": ["../../packages/app-vue/src/web-bootstrap.ts"],
      "@dailyuse/app-vue/web-entry": ["../../packages/app-vue/src/web-entry.ts"],
      "@dailyuse/app-vue": ["../../packages/app-vue/src/index.ts"],
      "@dailyuse/notification-runtime": ["../../packages/notification-runtime/src/index.ts"],
      "@dailyuse/ui-vue-shadcn/components/ui/*": [
        "../../packages/ui-vue-shadcn/src/components/ui/*/index.ts"
      ],
      "@dailyuse/ui-vue-shadcn/composables/*": ["../../packages/ui-vue-shadcn/src/composables/*"],
      "@dailyuse/authentication/application-client": [
        "../../packages/authentication/src/application-client/index.ts"
      ],
      "@dailyuse/authentication/infrastructure-client": [
        "../../packages/authentication/src/infrastructure-client/index.ts"
      ],
      "@dailyuse/ai/application-client": ["../../packages/ai/src/application-client/index.ts"],
      "@dailyuse/ai/infrastructure-client": [
        "../../packages/ai/src/infrastructure-client/index.ts"
      ],
      "@dailyuse/editor/application-client": ["../../packages/editor/src/application-client/index.ts"],
      "@dailyuse/editor/infrastructure-client": [
        "../../packages/editor/src/infrastructure-client/index.ts"
      ],
      "@dailyuse/http-client": ["../../packages/http-client/src/index.ts"],
      "@dailyuse/contracts": ["../../packages/contracts/src/index.ts"],
      "@dailyuse/contracts/notification": [
        "../../packages/contracts/src/modules/notification/index.ts"
      ],
      "@dailyuse/contracts/*": [
        "../../packages/contracts/src/modules/*/index.ts",
        "../../packages/contracts/src/*/index.ts"
      ],
      "@dailyuse/test-utils": ["../../packages/test-utils/src/index.ts"],
      "@dailyuse/test-utils/*": [
        "../../packages/test-utils/src/*",
        "../../packages/test-utils/src/*.ts"
      ],
      "@dailyuse/repository/application-client": [
        "../../packages/repository/dist/application-client/index.d.ts"
      ],
      "@dailyuse/repository/infrastructure-client": [
        "../../packages/repository/dist/infrastructure-client/index.d.ts"
      ],
      "@dailyuse/schedule/application-client": [
        "../../packages/schedule/dist/application-client/index.d.ts"
      ],
      "@dailyuse/schedule/infrastructure-client": [
        "../../packages/schedule/dist/infrastructure-client/index.d.ts"
      ]

      // 其他 @dailyuse/* 包通过 package.json dependencies + exports → dist 解析。
      // 这样让 build 阶段回到真实包边界，而不是长期依赖源码直连。
      // DI 类型使用 PublicInterface<T> 工具类型消除了 source-vs-dist
      // 的 private property 名义类型冲突。
    }
  },

  // ============================================================
  // 包含和排除配置
  // ============================================================

  // 包含的文件：src 目录和环境变量类型定义
  "include": ["src/**/*", "env.d.ts"],

  // 排除的文件
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.bench.ts",
    "src/benchmarks/**/*",
    "src/modules/ai/**/*"
  ]

  // 取消 TS Project References；前端类型由各包的 tsup d.ts 提供
}
