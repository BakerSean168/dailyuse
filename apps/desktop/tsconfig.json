{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "noEmit": true,

    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "moduleResolution": "Bundler",

    "paths": {
      "@/*": ["./src/*"],
      "@electron/*": ["./electron/*"],
      "@common/*": ["./common/*"],

      // UI layer packages: resolve to source (same pattern as web's tsconfig).
      // This ensures di/types.ts inline import() expressions degrade the same way
      // as in the web app, avoiding dist-vs-source type identity conflicts.
      "@dailyuse/app-vue": ["../../packages/app-vue/src/index.ts"],
      "@dailyuse/ui-vue-shadcn": ["../../packages/ui-vue-shadcn/src/index.ts"],
      "@dailyuse/contracts": ["../../packages/contracts/src/index.ts"],
      "@dailyuse/contracts/notification": [
        "../../packages/contracts/src/modules/notification/index.ts"
      ],
      "@dailyuse/contracts/*": ["../../packages/contracts/src/modules/*/index.ts"]
    }
  },

  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "electron/**/*", "common/**/*"],

  "exclude": ["node_modules", "dist", "dist-electron", "**/*.test.ts", "**/*.spec.ts"]
}
