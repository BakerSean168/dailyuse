{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@/*": ["./src/*"],
      "@electron/*": ["./electron/*"],
      "@common/*": ["./common/*"],
      "@dailyuse/app-vue": ["../../packages/app-vue/src/index.ts"],
      "@dailyuse/ui-vue-shadcn/composables/*": ["../../packages/ui-vue-shadcn/src/composables/*"],
      "@dailyuse/ai/client": ["../../packages/ai/src/client/index.ts"],
      "@dailyuse/ai/electron": ["../../packages/ai/src/electron/index.ts"],
      "@dailyuse/ai/ports": ["../../packages/ai/src/ports/index.ts"],
      "@dailyuse/goal/client": ["../../packages/goal/src/client/index.ts"],
      "@dailyuse/goal/electron": ["../../packages/goal/src/electron/index.ts"],
      "@dailyuse/goal/schedule-execution": [
        "../../packages/goal/src/schedule-execution/index.ts"
      ],
      "@dailyuse/goal/schedule-projection": [
        "../../packages/goal/src/schedule-projection/index.ts"
      ],
      "@dailyuse/task/client": ["../../packages/task/src/client/index.ts"],
      "@dailyuse/task/electron": ["../../packages/task/src/electron/index.ts"],
      "@dailyuse/task/schedule-execution": [
        "../../packages/task/src/schedule-execution/index.ts"
      ],
      "@dailyuse/task/schedule-projection": [
        "../../packages/task/src/schedule-projection/index.ts"
      ],
      "@dailyuse/schedule/client": ["../../packages/schedule/src/client/index.ts"],
      "@dailyuse/schedule/electron": ["../../packages/schedule/src/electron/index.ts"],
      "@dailyuse/reminder/client": ["../../packages/reminder/src/client/index.ts"],
      "@dailyuse/reminder/electron": ["../../packages/reminder/src/electron/index.ts"],
      "@dailyuse/notification/client": ["../../packages/notification/src/client/index.ts"],
      "@dailyuse/notification/electron": ["../../packages/notification/src/electron/index.ts"],
      "@dailyuse/ipc-client": ["../../packages/ipc-client/src/index.ts"],
      "@dailyuse/http-client": ["../../packages/http-client/src/index.ts"],
      "@dailyuse/dashboard": ["../../packages/dashboard/src/index.ts"],
      "@dailyuse/contracts": ["../../packages/contracts/src/index.ts"],
      "@dailyuse/contracts/notification": [
        "../../packages/contracts/src/modules/notification/index.ts"
      ],
      "@dailyuse/contracts/*": [
        "../../packages/contracts/src/modules/*/index.ts",
        "../../packages/contracts/src/*/index.ts"
      ],
      "@dailyuse/domain-shared": ["../../packages/domain-shared/src/index.ts"],
      "@dailyuse/utils": ["../../packages/utils/src/index.ts"],
      "@dailyuse/utils/*": ["../../packages/utils/src/*/index.ts", "../../packages/utils/src/*.ts"],
      "@dailyuse/goal/analytics": ["../../packages/goal/src/analytics/index.ts"],
      "@dailyuse/notification/commands": ["../../packages/notification/src/commands/index.ts"],
      "@dailyuse/task/analytics": ["../../packages/task/src/analytics/index.ts"],
      "@dailyuse/assets": ["../../packages/assets/src/index.ts"],
      "@dailyuse/assets/*": [
        "../../packages/assets/src/*/index.ts",
        "../../packages/assets/src/*.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "electron/**/*", "common/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron", "**/*.test.ts", "**/*.spec.ts"]
}
