// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.memoflow.app",
  "asar": true,
  "asarUnpack": [
    "node_modules/@powersync/node/**/*",
    "node_modules/@powersync/common/**/*",
    "node_modules/async-mutex/**/*",
    "node_modules/bson/**/*",
    "node_modules/comlink/**/*",
    "node_modules/event-iterator/**/*",
    "node_modules/bindings/**/*",
    "node_modules/file-uri-to-path/**/*",
    "node_modules/undici/**/*"
  ],
  "electronVersion": "39.2.6",
  "productName": "Memoflow",
  "directories": {
    "output": "dist-package",
    "buildResources": "build" // 添加资源目录配置
  },
  "files": [
    "dist-renderer/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../node_modules/bindings",
      "to": "node_modules/bindings"
    },
    {
      "from": "../../node_modules/file-uri-to-path",
      "to": "node_modules/file-uri-to-path"
    }
  ],
  "mac": {
    "icon": "build/icon.icns",
    "target": [
      "dmg",
      "zip"  // 添加 zip 格式支持自动更新
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}",
    "category": "public.app-category.productivity" // 添加应用类别
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip", // 添加 zip 格式支持自动更新
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,        // false: 显示安装过程界面，true: 一键安装
    "perMachine": false,      // false: 安装到当前用户，true: 安装到所有用户
    "allowToChangeInstallationDirectory": true,  // 允许用户选择安装目录
    "allowElevation": true,   // 允许请求提升权限（如需要管理员权限）
    "createDesktopShortcut": true,    // 创建桌面快捷方式
    "createStartMenuShortcut": true,   // 创建开始菜单快捷方式
    "shortcutName": "知行 (Memoflow)",
    "uninstallDisplayName": "知行 (Memoflow)",
    "deleteAppDataOnUninstall": false,  // 卸载时是否删除用户数据
    "displayLanguageSelector": true,    // 显示安装程序语言选择界面
    "installerLanguages": [            // 支持的安装程序语言
        "zh_CN",                       // 简体中文
        "en_US"                        // 英文
    ],
  },
  "linux": {
    "icon": "build/icon.png",
    "target": [
      "AppImage",
      "deb",  // 添加 deb 格式
      "rpm"   // 添加 rpm 格式
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}",
    "category": "Utility" // 添加应用类别
  },
  "publish": {
    "provider": "github",
    "owner": "BakerSean168",
    "repo": "dailyuse",
    "releaseType": "release" // 配置发布选项
  },
  "generateUpdatesFilesForAllChannels": true, // 为所有渠道生成更新文件
  "npmRebuild": false // 禁用自动原生模块重编译，由 package/dist 命令显式重编译 better-sqlite3
}
