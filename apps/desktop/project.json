{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "tags": ["scope:desktop", "type:app", "platform:electron", "layer:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/desktop/dist-renderer",
        "{workspaceRoot}/apps/desktop/dist-electron"
      ],
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "assets:build"],
      "options": {
        "command": "vite build",
        "cwd": "apps/desktop"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": [],
      "options": {
        "command": "vite",
        "cwd": "apps/desktop"
      },
      "configurations": {
        "development": {
          "command": "vite --mode development",
          "cwd": "apps/desktop"
        }
      }
    },
    "prepare-dev": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": ["^build", "native-rebuild"],
      "cache": false
    },
    "serve:full": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["prepare-dev"],
      "options": {
        "command": "vite",
        "cwd": "apps/desktop"
      },
      "configurations": {
        "development": {
          "command": "vite --mode development",
          "cwd": "apps/desktop"
        }
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "native-rebuild"],
      "options": {
        "commands": [
          "electron-builder --dir",
          "node ./scripts/verify-packaged-runtime-deps.mjs"
        ],
        "cwd": "apps/desktop",
        "parallel": false
      }
    },
    "native-rebuild": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec electron-rebuild -f -w better-sqlite3,argon2",
        "cwd": "apps/desktop"
      }
    },
    "dist": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "native-rebuild"],
      "options": {
        "commands": [
          "electron-builder --publish never",
          "node ./scripts/verify-packaged-runtime-deps.mjs"
        ],
        "cwd": "apps/desktop",
        "parallel": false
      },
      "configurations": {
        "windows": {
          "commands": [
            "electron-builder --win --x64 --publish never",
            "node ./scripts/verify-packaged-runtime-deps.mjs"
          ]
        },
        "linux": {
          "commands": [
            "electron-builder --linux AppImage deb rpm --x64 --publish never",
            "node ./scripts/verify-packaged-runtime-deps.mjs"
          ]
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/desktop/**/*.{ts,tsx,js,jsx,vue}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config apps/desktop/vitest.config.ts"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest --config apps/desktop/vitest.config.ts"
      }
    },
    "test:ipc": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/desktop-ipc"],
      "options": {
        "command": "vitest run --config vitest.ipc.config.ts",
        "cwd": "apps/desktop"
      }
    },
    "test:ipc:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest --config vitest.ipc.config.ts",
        "cwd": "apps/desktop"
      }
    },
    "test:main": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/desktop-main"],
      "options": {
        "command": "vitest run --config vitest.main.config.ts",
        "cwd": "apps/desktop"
      }
    },
    "db:reset": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-db.mjs",
        "cwd": "apps/desktop"
      }
    },
    "db:reset:dry": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-db.mjs --dry-run",
        "cwd": "apps/desktop"
      }
    },
    "local-data:reset": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-data.mjs",
        "cwd": "apps/desktop"
      }
    },
    "local-data:reset:dry": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-data.mjs --dry-run",
        "cwd": "apps/desktop"
      }
    },
    "local-data:reset:auth": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-data.mjs auth",
        "cwd": "apps/desktop"
      }
    },
    "local-data:reset:auth:dry": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-data.mjs auth --dry-run",
        "cwd": "apps/desktop"
      }
    },
    "local-data:reset:db": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-data.mjs db",
        "cwd": "apps/desktop"
      }
    },
    "local-data:reset:db:dry": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-data.mjs db --dry-run",
        "cwd": "apps/desktop"
      }
    },
    "local-data:reset:all": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-data.mjs all",
        "cwd": "apps/desktop"
      }
    },
    "local-data:reset:all:dry": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ./scripts/reset-local-data.mjs all --dry-run",
        "cwd": "apps/desktop"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/desktop"
      }
    }
  }
}
