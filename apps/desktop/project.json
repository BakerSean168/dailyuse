{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "tags": ["scope:desktop", "type:app", "platform:electron", "layer:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/desktop/dist",
        "{workspaceRoot}/apps/desktop/dist-electron"
      ],
      "defaultConfiguration": "production",
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "apps/desktop"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["^build"],
      "options": {
        "command": "vite",
        "cwd": "apps/desktop"
      },
      "configurations": {
        "development": {
          "command": "vite --mode development",
          "cwd": "apps/desktop"
        }
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx @electron/rebuild -f -o better-sqlite3",
          "electron-builder --dir"
        ],
        "cwd": "apps/desktop",
        "parallel": false
      }
    },
    "dist": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx @electron/rebuild -f -o better-sqlite3",
          "electron-builder"
        ],
        "cwd": "apps/desktop",
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/desktop/**/*.{ts,tsx,js,jsx,vue}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --project desktop"
      }
    },
    "test:ipc": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/desktop-ipc"],
      "options": {
        "command": "vitest run --config vitest.ipc.config.ts",
        "cwd": "apps/desktop"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/desktop"
      }
    }
  }
}
