{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "tags": ["scope:desktop", "type:app", "platform:electron", "layer:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/desktop/dist",
        "{workspaceRoot}/apps/desktop/dist-electron"
      ],
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "assets:build"],
      "options": {
        "command": "vite build",
        "cwd": "apps/desktop"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["^build", "native-rebuild"],
      "options": {
        "command": "vite",
        "cwd": "apps/desktop"
      },
      "configurations": {
        "development": {
          "command": "vite --mode development",
          "cwd": "apps/desktop"
        }
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "native-rebuild"],
      "options": {
        "commands": ["electron-builder --dir"],
        "cwd": "apps/desktop",
        "parallel": false
      }
    },
    "native-rebuild": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "electron-rebuild -f -w better-sqlite3",
        "cwd": "apps/desktop"
      }
    },
    "dist": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "native-rebuild"],
      "options": {
        "command": "electron-builder --publish never",
        "cwd": "apps/desktop",
        "parallel": false
      },
      "configurations": {
        "windows": {
          "command": "electron-builder --win --x64 --publish never"
        },
        "linux": {
          "command": "electron-builder --linux AppImage deb rpm --x64 --publish never"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/desktop/**/*.{ts,tsx,js,jsx,vue}"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config apps/desktop/vitest.config.ts"
      }
    },
    "test:ipc": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/desktop-ipc"],
      "options": {
        "command": "vitest run --config vitest.ipc.config.ts",
        "cwd": "apps/desktop"
      }
    },
    "test:main": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/desktop-main"],
      "options": {
        "command": "vitest run --project desktop-main",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/desktop"
      }
    }
  }
}
