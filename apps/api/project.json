{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:api", "type:app", "layer:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/tsx/dist/cli.mjs watch src/main.ts",
        "cwd": "apps/api"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "dependsOn": ["^build"],
      "options": {
        "command": "node ../../node_modules/tsup/dist/cli-default.js",
        "cwd": "apps/api"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm start",
        "cwd": "apps/api"
      },
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --project api"
      }
    },
    "test:smoke": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}-smoke"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --project api-smoke"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/api/**/*.{ts,js}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma:generate"],
      "options": {
        "command": "tsc --noEmit -p tsconfig.typecheck.json",
        "cwd": "apps/api"
      }
    },
    "prisma:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm prisma:generate",
        "cwd": "apps/api"
      }
    },
    "prisma:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm prisma:migrate",
        "cwd": "apps/api"
      }
    },
    "prisma:studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm prisma:studio",
        "cwd": "apps/api"
      }
    },
    "prisma:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm prisma:seed",
        "cwd": "apps/api"
      }
    },
    "db:push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm prisma db push",
        "cwd": "apps/api"
      }
    }
  }
}
