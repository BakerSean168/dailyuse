{
  // 继承基础配置
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // ============================================================
    // 路径和输出配置
    // ============================================================

    // 基础路径：相对路径的起点
    "baseUrl": ".",

    // 输出目录：编译后的 JavaScript 和声明文件
    "outDir": "./dist",

    // 源码根目录：限制编译范围
    "rootDir": "./src",

    // 生成输出文件（应用项目需要构建产物）
    "noEmit": false,

    // ============================================================
    // Composite 项目配置（Monorepo 关键）
    // ============================================================

    // 关闭 composite（改用 tsup 负责类型与构建）
    // 说明：避免 TS Project References 带来的耦合与报错
    "composite": false,

    // 生成类型声明文件（.d.ts）
    "declaration": true,

    // 生成声明文件的 source map（.d.ts.map）
    // 作用：IDE 可以从声明文件跳转回 TypeScript 源码
    "declarationMap": true,

    // 生成 JavaScript 的 source map（.js.map）
    // 作用：调试时可以断点到 TypeScript 源码
    "sourceMap": true,

    // ============================================================
    // Node.js 环境配置
    // ============================================================

    // 标准库：仅包含 ES2020（不包含 DOM）
    "lib": ["ES2020"],

    // 类型定义：只包含 Node.js 类型
    "types": ["node"],

    // 模块解析：使用 Bundler 策略（支持无扩展名导入）
    // Bundler 策略允许导入时省略 .js 扩展名，由构建工具处理
    "moduleResolution": "Bundler",

    // 允许导入 JSON 文件
    "resolveJsonModule": true,

    // ============================================================
    // 本地路径别名配置
    // ============================================================

    // 路径别名：项目内部走 @/，少量共享包走源码直连
    // 避免 typecheck 隐式依赖上游包 dist 产物
    "paths": {
      // 项目内部别名：@/ 指向 src 目录
      "@/*": ["./src/*"],
      "@dailyuse/contracts": ["../../packages/contracts/src/index.ts"],
      "@dailyuse/contracts/*": [
        "../../packages/contracts/src/modules/*/index.ts",
        "../../packages/contracts/src/*/index.ts"
      ],
      "@dailyuse/http-client": ["../../packages/http-client/src/index.ts"],
      "@dailyuse/utils": ["../../packages/utils/src/index.ts"],
      "@dailyuse/utils/*": ["../../packages/utils/src/*/index.ts"],
      "@dailyuse/governance": ["../../packages/governance/dist/index.d.ts"],
      "@dailyuse/governance/api": ["../../packages/governance/dist/api/index.d.ts"],
      "@dailyuse/account": ["../../packages/account/dist/index.d.ts"],
      "@dailyuse/account/api": ["../../packages/account/dist/api/index.d.ts"],
      "@dailyuse/authentication": ["../../packages/authentication/dist/index.d.ts"],
      "@dailyuse/authentication/api": ["../../packages/authentication/dist/api/index.d.ts"],
      "@dailyuse/goal": ["../../packages/goal/dist/index.d.ts"],
      "@dailyuse/goal/api": ["../../packages/goal/dist/api/index.d.ts"],
      "@dailyuse/reminder": ["../../packages/reminder/dist/index.d.ts"],
      "@dailyuse/reminder/api": ["../../packages/reminder/dist/api/index.d.ts"],
      "@dailyuse/setting": ["../../packages/setting/dist/index.d.ts"],
      "@dailyuse/setting/api": ["../../packages/setting/dist/api/index.d.ts"],
      "@dailyuse/task": ["../../packages/task/dist/index.d.ts"],
      "@dailyuse/task/api": ["../../packages/task/dist/api/index.d.ts"],
      "@dailyuse/ai": ["../../packages/ai/dist/index.d.ts"],
      "@dailyuse/ai/api": ["../../packages/ai/dist/api/index.d.ts"],
      "@dailyuse/ai/application-server": ["../../packages/ai/dist/application-server/index.d.ts"],
      "@dailyuse/repository": ["../../packages/repository/dist/index.d.ts"]

      // 其他 @dailyuse/* 仍优先通过 package.json exports → dist 解析
    }
  },

  // ============================================================
  // 包含和排除配置
  // ============================================================

  // 包含的文件：所有 src 目录下的 TypeScript 文件
  "include": ["src/**/*"],

  // 排除的文件：
  // - node_modules: 第三方依赖
  // - dist: 构建输出（避免重复编译）
  // - *.test.ts: 测试文件（可选，根据需求决定）
  // - *.spec.ts: 规范文件（可选）
  // - src/**/__tests__/manual/**/*: 手动测试文件使用旧的 API
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.deprecated.ts",
    "src/**/__tests__/manual/**/*",
    "src/**/__tests__/smoke/**/*"
  ]

  // 保持非引用式构建；仅对白名单共享包使用源码类型联调
}
