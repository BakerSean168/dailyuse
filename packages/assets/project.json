{
  "name": "assets",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/assets/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:lib",
    "type:assets",
    "layer:shared"
  ],
  "targets": {
    "generate-icons": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pwsh -File ./scripts/generate-brand-assets.ps1",
        "cwd": "packages/assets"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "vite build",
        "cwd": "packages/assets"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "vitest run --project assets"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest --project assets"
      }
    }
  }
}
