{
  "name": "ui-vue",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui-vue/src",
  "tags": ["scope:ui", "type:vue"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/ui-vue/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "packages/ui-vue"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --watch",
        "cwd": "packages/ui-vue"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/ui-vue/**/*.ts"]
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4402 -c packages/ui-vue/.storybook",
        "cwd": "."
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/storybook/ui-vue"],
      "options": {
        "command": "storybook build -c packages/ui-vue/.storybook -o dist/storybook/ui-vue",
        "cwd": "."
      }
    }
  },
  "implicitDependencies": ["ui-core"]
}
