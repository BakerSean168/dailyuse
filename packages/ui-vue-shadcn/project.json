{
  "name": "ui-vue-shadcn",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui-vue-shadcn/src",
  "tags": ["scope:ui", "type:vue", "type:shadcn", "layer:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/ui-vue-shadcn/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --watch",
        "cwd": "packages/ui-vue-shadcn"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4402 -c packages/ui-vue-shadcn/.storybook",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/ui-vue-shadcn/**/*.{ts,tsx}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vue-tsc --noEmit -p tsconfig.typecheck.json",
        "cwd": "packages/ui-vue-shadcn"
      }
    }
  }
}
