{
  "name": "task",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/task/src",
  "projectType": "library",
  "tags": ["scope:task", "type:lib", "layer:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup --clean=false",
        "cwd": "packages/task"
      },
      "dependsOn": ["^build", "database:build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/task/**/*.{ts,js}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/task"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest --config vitest.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.integration.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:bench": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}-bench"],
      "inputs": ["default", "^production"],
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.performance.config.ts -t \"acceptable time\"",
        "cwd": "packages/task"
      }
    }
  }
}
