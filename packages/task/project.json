{
  "name": "task",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/task/src",
  "projectType": "library",
  "tags": ["scope:task", "type:lib", "layer:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm exec tsup --clean=false && pnpm exec tsc -p tsconfig.build.json --emitDeclarationOnly",
        "cwd": "packages/task"
      },
      "dependsOn": ["^build", "database:build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/task/**/*.{ts,js}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/task"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
        "cwd": "packages/task"
      }
    },
    "test:bench": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}-bench"],
      "inputs": ["default", "^production"],
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.performance.config.ts -t \"acceptable time\"",
        "cwd": "packages/task"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts --coverage",
        "cwd": "packages/task"
      }
    },
    "test:coverage:use-cases": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/application-server-use-cases"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.use-cases.config.ts --coverage",
        "cwd": "packages/task"
      }
    },
    "test:coverage:prisma-mappers": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}/infrastructure-server-adapters-prisma-mappers"
      ],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.mappers.config.ts --coverage",
        "cwd": "packages/task"
      }
    }
  }
}
