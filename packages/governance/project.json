{
  "name": "governance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/governance/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/governance",
        "main": "packages/governance/src/index.ts",
        "tsConfig": "packages/governance/tsconfig.lib.json",
        "assets": ["packages/governance/*.md"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --config vitest.config.ts",
        "cwd": "packages/governance"
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "parallelism": true
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
