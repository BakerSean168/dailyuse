{
  "name": "governance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/governance/src",
  "projectType": "library",
  "tags": ["scope:governance", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup",
        "cwd": "packages/governance"
      },
      "dependsOn": ["^build", "database:build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/governance/**/*.{ts,js}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/governance"
      }
    }
  }
}
