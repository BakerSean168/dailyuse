{
  "name": "example-sample",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/example-sample/src",
  "projectType": "library",
  "tags": ["scope:sample", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup",
        "cwd": "packages/example-sample"
      },
      "dependsOn": ["^build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/example-sample/**/*.{ts,js}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/example-sample"
      }
    }
  }
}
