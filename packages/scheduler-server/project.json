{
  "name": "scheduler-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/scheduler-server/src",
  "projectType": "library",
  "tags": [
    "scope:scheduler",
    "layer:infra"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsup",
        "cwd": "packages/scheduler-server"
      },
      "dependsOn": ["^build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/scheduler-server/**/*.ts"
        ]
      },
      "cache": true
    }
  }
}
