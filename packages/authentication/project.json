{
  "name": "authentication",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/authentication/src",
  "projectType": "library",
  "tags": ["scope:authentication", "type:lib", "layer:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm exec tsup --clean=false && pnpm exec tsc -p tsconfig.build.json --emitDeclarationOnly",
        "cwd": "packages/authentication"
      },
      "dependsOn": ["^build", "database:build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm tsup --watch --clean=false",
        "cwd": "packages/authentication"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.config.ts",
        "cwd": "packages/authentication"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest --config vitest.config.ts",
        "cwd": "packages/authentication"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.config.ts --coverage",
        "cwd": "packages/authentication"
      }
    }
  }
}
