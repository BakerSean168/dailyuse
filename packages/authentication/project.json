{
  "name": "authentication",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/authentication/src",
  "projectType": "library",
  "tags": ["scope:authentication", "type:lib", "layer:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm tsup",
        "cwd": "packages/authentication"
      },
      "dependsOn": ["^build", "database:build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --project authentication"
      }
    }
  }
}
