{
  "name": "ui-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui-react/src",
  "tags": ["scope:ui", "type:react", "layer:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/ui-react/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "tsup",
        "cwd": "packages/ui-react"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup --watch",
        "cwd": "packages/ui-react"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/ui-react/**/*.{ts,tsx}"]
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4401 -c packages/ui-react/.storybook",
        "cwd": "."
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/storybook/ui-react"],
      "options": {
        "command": "storybook build -c packages/ui-react/.storybook -o dist/storybook/ui-react",
        "cwd": "."
      }
    }
  },
  "implicitDependencies": ["ui-core", "ui-react-shadcn"]
}
