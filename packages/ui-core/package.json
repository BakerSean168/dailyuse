{
  "name": "@dailyuse/ui-core",
  "version": "0.0.1",
  "description": "Framework-agnostic headless UI logic for DailyUse applications",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./tailwind.preset": "./tailwind.preset.js"
  },
  "files": [
    "dist",
    "src/styles",
    "tailwind.preset.js"
  ],
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tailwindcss": "4.1.18",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
