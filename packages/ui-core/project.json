{
  "name": "ui-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui-core/src",
  "tags": ["scope:ui", "type:core", "layer:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/ui-core/dist"],
      "options": {
        "parallel": false,
        "commands": [
          {
            "command": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup --clean=false",
            "forwardAllArgs": false
          }
        ],
        "cwd": "packages/ui-core"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "tsup --watch",
            "forwardAllArgs": false
          }
        ],
        "cwd": "packages/ui-core"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "packages/ui-core"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/ui-core/**/*.ts"]
      }
    }
  }
}
