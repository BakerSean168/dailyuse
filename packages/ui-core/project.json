{
  "name": "ui-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/ui-core/src",
  "tags": ["scope:ui", "type:core", "layer:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/ui-core/dist"],
      "options": {
        "parallel": false,
        "commands": [
          {
            "command": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node ../../node_modules/tsup/dist/cli-default.js --clean=false",
            "forwardAllArgs": false
          }
        ],
        "cwd": "packages/ui-core"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "node ../../node_modules/tsup/dist/cli-default.js --watch",
            "forwardAllArgs": false
          }
        ],
        "cwd": "packages/ui-core"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.config.ts",
        "cwd": "packages/ui-core"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
        "cwd": "packages/ui-core"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/ui-core/**/*.ts"]
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest --config vitest.config.ts",
        "cwd": "packages/ui-core"
      }
    }
  }
}
