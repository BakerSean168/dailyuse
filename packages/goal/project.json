{
  "name": "goal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/goal/src",
  "projectType": "library",
  "tags": ["scope:goal", "type:lib", "layer:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm exec tsup --clean=false && pnpm exec tsc -p tsconfig.build.json --emitDeclarationOnly",
        "cwd": "packages/goal"
      },
      "dependsOn": ["^build", "database:build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/goal/**/*.{ts,js}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/goal"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.config.ts",
        "cwd": "packages/goal"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest --config vitest.config.ts",
        "cwd": "packages/goal"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.integration.config.ts",
        "cwd": "packages/goal"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.config.ts --coverage",
        "cwd": "packages/goal"
      }
    },
    "test:coverage:use-cases": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/application-server-use-cases"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.use-cases.config.ts --coverage",
        "cwd": "packages/goal"
      }
    },
    "test:coverage:prisma-mappers": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/infrastructure-server-adapters-prisma-mappers"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --config vitest.mappers.config.ts --coverage",
        "cwd": "packages/goal"
      }
    }
  }
}
