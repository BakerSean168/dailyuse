{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "ES2020"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@dailyuse/database": [
        "../database/src/index.ts"
      ],
      "@dailyuse/http-client": [
        "../http-client/src/index.ts"
      ],
      "@dailyuse/domain-shared": [
        "../domain-shared/src/index.ts"
      ],
      "@dailyuse/domain-shared/*": [
        "../domain-shared/src/*/index.ts"
      ],
      "@dailyuse/contracts": [
        "../contracts/src/index.ts"
      ],
      "@dailyuse/contracts/*": [
        "../contracts/src/modules/*/index.ts"
      ],
      "@dailyuse/utils": [
        "../utils/src/index.ts"
      ],
      "@dailyuse/patterns": [
        "../patterns/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
