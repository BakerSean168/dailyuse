{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2020"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@dailyuse/database": ["../database/src/index.ts"],
      "@dailyuse/http-client": ["../http-client/src/index.ts"],
      "@dailyuse/contracts": ["../contracts/src/index.ts"],
      "@dailyuse/domain-shared": ["../domain-shared/src/index.ts"],
      "@dailyuse/contracts/reminder": ["../contracts/src/modules/reminder/index.ts"],
      "@dailyuse/contracts/result": ["../contracts/src/result/index.ts"],
      "@dailyuse/contracts/shared": ["../contracts/src/shared/index.ts"],
      "@dailyuse/contracts/primitives": ["../contracts/src/primitives/index.ts"],
      "@dailyuse/contracts/electron": ["../contracts/src/electron/index.ts"],
      "@dailyuse/contracts/schedule": ["../contracts/src/modules/schedule/index.ts"],
      "@dailyuse/schedule": ["../schedule/src/index.ts"],
      "@dailyuse/schedule/domain-server": ["../schedule/src/domain-server/index.ts"],
      "@dailyuse/schedule/domain-shared": ["../schedule/src/domain-shared/index.ts"],
      "@dailyuse/schedule/infrastructure-server": ["../schedule/src/infrastructure-server/index.ts"],
      "@dailyuse/test-utils": ["../test-utils/src/index.ts"],
      "@dailyuse/test-utils/*": ["../test-utils/src/*", "../test-utils/src/*.ts"],
      "@dailyuse/utils": ["../utils/src/index.ts"],
      "@dailyuse/utils/result": ["../utils/src/result/index.ts"],
      "@dailyuse/patterns": ["../patterns/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
