{
  "name": "app-vue",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/app-vue/src",
  "tags": ["scope:app-vue", "type:lib", "type:vue", "layer:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/app-vue/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "vite build",
        "cwd": "packages/app-vue"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/app-vue/**/*.{ts,tsx,vue}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/app-vue"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/app-vue"
      }
    }
  }
}
