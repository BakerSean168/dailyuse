{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "incremental": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@dailyuse/contracts": ["../../packages/contracts/src/index.ts"],
      "@dailyuse/contracts/*": ["../../packages/contracts/src/modules/*/index.ts"],
      "@dailyuse/ai": ["../../packages/ai/src/index.ts"],
      "@dailyuse/ai/*": ["../../packages/ai/src/*/index.ts"],
      "@dailyuse/task": ["../../packages/task/src/index.ts"],
      "@dailyuse/task/*": ["../../packages/task/src/*/index.ts"],
      "@dailyuse/repository": ["../../packages/repository/src/index.ts"],
      "@dailyuse/repository/*": ["../../packages/repository/src/*/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
