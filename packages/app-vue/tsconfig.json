{
  "extends": "../../tsconfig.workspace-src.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "incremental": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@dailyuse/contracts": ["../../packages/contracts/src/index.ts"],
      "@dailyuse/contracts/account": ["../../packages/contracts/src/modules/account/index.ts"],
      "@dailyuse/contracts/ai": ["../../packages/contracts/src/modules/ai/index.ts"],
      "@dailyuse/contracts/authentication": [
        "../../packages/contracts/src/modules/authentication/index.ts"
      ],
      "@dailyuse/contracts/dashboard": ["../../packages/contracts/src/dashboard/index.ts"],
      "@dailyuse/contracts/editor": ["../../packages/contracts/src/modules/editor/index.ts"],
      "@dailyuse/contracts/goal": ["../../packages/contracts/src/modules/goal/index.ts"],
      "@dailyuse/contracts/notification": [
        "../../packages/contracts/src/modules/notification/index.ts"
      ],
      "@dailyuse/contracts/primitives": ["../../packages/contracts/src/primitives/index.ts"],
      "@dailyuse/contracts/reminder": ["../../packages/contracts/src/modules/reminder/index.ts"],
      "@dailyuse/contracts/repository": [
        "../../packages/contracts/src/modules/repository/index.ts"
      ],
      "@dailyuse/contracts/result": ["../../packages/contracts/src/result/index.ts"],
      "@dailyuse/contracts/schedule": ["../../packages/contracts/src/modules/schedule/index.ts"],
      "@dailyuse/contracts/setting": ["../../packages/contracts/src/modules/setting/index.ts"],
      "@dailyuse/contracts/shared": ["../../packages/contracts/src/shared/index.ts"],
      "@dailyuse/contracts/task": ["../../packages/contracts/src/modules/task/index.ts"],
      "@dailyuse/contracts/*": [
        "../../packages/contracts/src/modules/*/index.ts",
        "../../packages/contracts/src/*/index.ts"
      ],
      "@dailyuse/assets": ["../../packages/assets/src/index.ts"],
      "@dailyuse/assets/audio": ["../../packages/assets/src/audio/index.ts"],
      "@dailyuse/assets/images": ["../../packages/assets/src/images/index.ts"],
      "@dailyuse/ui-vue-shadcn": ["../../packages/ui-vue-shadcn/dist/index.d.ts"],
      "@dailyuse/ui-vue-shadcn/components/ui/*": [
        "../../packages/ui-vue-shadcn/dist/components/ui/*/index.d.ts"
      ],
      "@dailyuse/ui-vue-shadcn/composables/*": [
        "../../packages/ui-vue-shadcn/dist/composables/*.d.ts"
      ],
      "@dailyuse/ui-vue-shadcn/*": ["../../packages/ui-vue-shadcn/dist/*"],
      "@dailyuse/http-client": ["../../packages/http-client/src/index.ts"],
      "@dailyuse/ai/application-client": ["../../packages/ai/dist/application-client/index.d.ts"],
      "@dailyuse/goal/application-client": [
        "../../packages/goal/dist/application-client/index.d.ts"
      ],
      "@dailyuse/task/application-client": [
        "../../packages/task/dist/application-client/index.d.ts"
      ],
      "@dailyuse/ai/infrastructure-client": [
        "../../packages/ai/src/infrastructure-client/index.ts"
      ],
      "@dailyuse/governance/client": [
        "../../packages/governance/dist/client/index.d.ts"
      ],
      "@dailyuse/schedule/domain-client": ["../../packages/schedule/src/domain-client/index.ts"],
      "@dailyuse/task/domain-client": ["../../packages/task/src/domain-client/index.ts"],
      "@dailyuse/repository/domain-client": ["../../packages/repository/src/domain-client/index.ts"],
      "@dailyuse/test-utils": ["../../packages/test-utils/src/index.ts"],
      "@dailyuse/test-utils/*": [
        "../../packages/test-utils/src/*",
        "../../packages/test-utils/src/*.ts"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

