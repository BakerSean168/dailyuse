// ==========================================
// Focus Module
// 专注会话、专注模式
// ==========================================

model FocusSession {
  id                    String    @id
  identityId            String    @map("identity_id")
  goalId                String?   @map("goal_id")
  status                String    @default("DRAFT")
  durationMinutes       Int       @map("duration_minutes")
  actualDurationMinutes Int       @default(0) @map("actual_duration_minutes")
  description           String?
  startedAt             DateTime? @map("started_at")
  pausedAt              DateTime? @map("paused_at")
  resumedAt             DateTime? @map("resumed_at")
  completedAt           DateTime? @map("completed_at")
  cancelledAt           DateTime? @map("cancelled_at")
  pauseCount            Int       @default(0) @map("pause_count")
  pausedDurationMinutes Int       @default(0) @map("paused_duration_minutes")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)
  goal    Goal?   @relation(fields: [goalId], references: [id])

  @@index([status])
  @@map("focus_sessions")
}

model FocusMode {
  id              String    @id
  identityId      String    @map("identity_id")
  focusedGoalIds  String[]  @map("focused_goal_ids")
  startTime       DateTime  @map("start_time")
  endTime         DateTime  @map("end_time")
  hiddenGoalsMode String    @map("hidden_goals_mode")
  isActive        Boolean   @default(true) @map("is_active")
  actualEndTime   DateTime? @map("actual_end_time")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([isActive])
  @@index([endTime])
  @@map("focus_modes")
}
