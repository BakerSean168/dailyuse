{
  "name": "patterns",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/patterns/src",
  "projectType": "library",
  "tags": ["scope:patterns", "layer:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup",
        "cwd": "packages/patterns"
      },
      "dependsOn": ["^build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "vitest run --project patterns"
      }
    }
  }
}
