{
  "name": "@dailyuse/patterns",
  "version": "0.0.1",
  "description": "Reusable design patterns and utilities for DailyUse applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "import": "./dist/scheduler/index.js"
    },
    "./repository": {
      "types": "./dist/repository/index.d.ts",
      "import": "./dist/repository/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js"
    }
  },
  "dependencies": {
    "@dailyuse/contracts": "workspace:*",
    "@dailyuse/utils": "workspace:*"
  },
  "devDependencies": {
    "@nx/vite": "22.5.3",
    "tsup": "^8.5.0",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
