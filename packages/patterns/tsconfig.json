{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    // ============================================================
    // 路径和输出配置
    // ============================================================

    // 基础路径：相对路径的起点
    "baseUrl": ".",

    // ============================================================
    // 库环境配置（Patterns 包）
    // ============================================================

    // 标准库：仅包含 ES2020（不包含 DOM）
    "lib": ["ES2020"],

    // 类型定义：包含 Node.js 和 Vitest 类型
    "types": ["node", "vitest/globals"],

    // ============================================================
    // 本地路径别名配置
    // ============================================================

    // 路径别名：仅用于包内部导入
    "paths": {
      "@/*": ["./src/*"]

      // 依赖的包通过编译时依赖引用
      // TypeScript 会从它们的 dist 目录读取类型
    }
  },

  // ============================================================
  // 包含和排除配置
  // ============================================================

  // 包含的文件 - 包含所有 TypeScript 文件
  "include": ["src"],

  // 排除的文件
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
