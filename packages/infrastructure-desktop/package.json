{
  "name": "@dailyuse/infrastructure-desktop",
  "version": "0.0.1",
  "description": "DailyUse Desktop Infrastructure Layer - SQLite Repositories for Electron/Desktop Apps",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./repository": {
      "types": "./dist/repository/index.d.ts",
      "import": "./dist/repository/index.js"
    }
  },
  "dependencies": {
    "@dailyuse/contracts": "workspace:*",
    "@dailyuse/domain-server": "workspace:*",
    "@dailyuse/infrastructure-server": "workspace:*",
    "@dailyuse/utils": "workspace:*",
    "better-sqlite3": "^11.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.x",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false
}
