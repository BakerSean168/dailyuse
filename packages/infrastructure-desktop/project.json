{
  "name": "infrastructure-desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/infrastructure-desktop/src",
  "prefix": "",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/infrastructure-desktop",
        "main": "packages/infrastructure-desktop/src/index.ts",
        "tsConfig": "packages/infrastructure-desktop/tsconfig.json",
        "assets": [],
        "format": ["esm"],
        "platform": "node"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project packages/infrastructure-desktop/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:vitest",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "vitest": true,
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  },
  "tags": ["type:lib", "scope:infrastructure"]
}
