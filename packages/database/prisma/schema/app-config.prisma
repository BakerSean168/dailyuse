// ==========================================
// App Config Module
// 应用配置
// ==========================================

model AppConfig {
  id          String   @id
  version     String   @unique
  config      String
  description String?
  isCurrent   Boolean  @default(false) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([version])
  @@map("app_configs")
}
