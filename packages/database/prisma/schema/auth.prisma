// ==========================================
// Auth Module
// 认证聚合根、凭证、会话
// ==========================================

// 1. 使用枚举保持与领域层 Value Object 一致
enum AuthIdentityStatus {
  ACTIVE // 正常
  LOCKED // 多次尝试失败锁定
  DISABLED // 管理员禁用
  UNVERIFIED // 未验证
}

enum CredentialType {
  PASSWORD
  OAUTH
  PHONE
  MAGIC_LINK
  // PASSKEY // 未来扩展
}

enum CredentialStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED // 如：用户解绑了 Google，或者重置了密码导致旧凭证失效
}

// ==========================================
// 1. 身份聚合根表 (AuthIdentity)
// ==========================================
model AuthIdentity {
  id     String             @id @default(uuid())
  status AuthIdentityStatus @default(UNVERIFIED)

  // 安全风控字段 (对应聚合根内部状态)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedAttempt   DateTime? @map("last_failed_attempt")
  lockedUntil         DateTime? @map("locked_until")

  // 时间戳
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 关联
  credentials AuthCredential[]
  sessions    AuthSession[]
  accounts    Account[]

  @@map("auth_identities")
}

// ==========================================
// 2. 凭证实体表 (AuthCredential)
// 采用 "单表继承 (Single Table Inheritance)" 策略
// ==========================================
model AuthCredential {
  id String @id @default(uuid())

  // 归属的身份
  identityId String       @map("identity_id")
  identity   AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // 核心字段
  type   CredentialType
  status CredentialStatus @default(ACTIVE)

  // [Type: PASSWORD]
  identifier            String? // 邮箱 或 手机号 (用于快速查找)
  passwordHash          String?   @map("password_hash") // Argon2 hash
  passwordLastChangedAt DateTime? @map("password_last_changed_at") // 密码最后修改时间

  // [Type: OAUTH]
  provider          String? // GOOGLE, GITHUB (数据库存字符串，代码转枚举)
  providerSubjectId String?   @map("provider_subject_id") // 第三方返回的 sub / openid
  accessToken       String?   @map("access_token") // 视安全需求，可能需要加密存储
  refreshToken      String?   @map("refresh_token") // 视安全需求，可能需要加密存储
  oauthExpiresAt    DateTime? @map("oauth_expires_at") // Token 过期时间

  // [Type: PHONE]
  isVerified Boolean? @default(false) @map("is_verified")

  // 元数据
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  deletedAt  DateTime? @map("deleted_at")

  @@unique([identifier, type])
  @@unique([provider, providerSubjectId])
  @@index([identityId, type])
  @@map("auth_credentials")
}

// ==========================================
// 3. 会话聚合根表 (AuthSession)
// ==========================================
model AuthSession {
  id String @id @default(uuid())

  identityId String       @map("identity_id")
  identity   AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // 核心令牌数据
  refreshTokenHash String? @map("refresh_token_hash") // 支持 Refresh Token 轮换

  // 设备信息 (对应 DeviceInfo Value Object)
  deviceId          String  @map("device_id")
  deviceFingerprint String  @map("device_fingerprint")
  deviceType        String  @map("device_type") // MOBILE, DESKTOP
  deviceName        String? @map("device_name")
  os                String?
  browser           String?
  ipAddress         String? @map("ip_address")

  // 地理位置 (用 JSON 存比较灵活，因为字段不确定)
  location Json? // { country, city, timezone }

  // 生命周期
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([identityId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
