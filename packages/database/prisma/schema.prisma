// ==================== Governance Models ====================

/// Rule 聚合根 — 架构规则的核心实体
model Rule {
  id                      String   @id
  code                    String   @unique  // e.g., DDD-001, ARCH-002
  title                   String
  description             String   @db.Text // Markdown, 10-5000 chars
  severity                String             // Mandatory | Recommended
  status                  String             // Draft | Active | Deprecated
  deprecationReason       String?
  replacementRuleId       String?
  liveReferenceLocation   String?            // Monorepo relative path
  tags                    String   @db.Text  // JSON array of normalized tags
  goodExamples            String   @db.Text  // JSON array of CodeSnippet objects
  badExamples             String   @db.Text  // JSON array of CodeSnippet objects
  authorId                String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  revisions               RuleRevision[]
  replacedBy              Rule?    @relation("RuleReplacement", fields: [replacementRuleId], references: [id], onDelete: SetNull)
  replaces                Rule[]   @relation("RuleReplacement")

  @@index([code])
  @@index([status])
  @@index([severity])
  @@index([authorId])
  @@map("rules")
}

/// RuleRevision 不可变实体 — 规则变更的审计历史
model RuleRevision {
  id              String   @id
  ruleId          String
  revisionNumber  Int      // Sequential: 1, 2, 3...
  authorId        String
  changedFields   String   @db.Text  // JSON array of field names
  previousValues  String?  @db.Text  // JSON object of old values
  newValues       String?  @db.Text  // JSON object of new values
  changeType      String             // Created | Updated | Deprecated | Reactivated
  createdAt       DateTime @default(now())

  // Relations
  rule            Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, revisionNumber])
  @@index([ruleId])
  @@index([authorId])
  @@map("rule_revisions")
}
