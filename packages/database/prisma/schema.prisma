// =============================================================
// DailyUse Database Schema — Single Source of Truth
// =============================================================
//
// 所有模块的数据库模型定义统一在此文件管理。
// 新模块的仓储实现放在各自的 package 内部，但 Model 定义在这里。
//
// 模块索引：
//   - Account / Authentication
//   - Repository / Resource
//   - Task
//   - Goal
//   - Schedule
//   - Reminder
//   - Notification
//   - Dashboard / Setting
//   - AI
//   - Governance                 ← 新增
// =============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Account Models ====================

model account {
  id        String   @id @default(cuid())
  uuid      String   @unique
  username  String   @unique
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authSessions authSession[]
}

// ==================== Authentication Models ====================

model authCredential {
  id            String   @id @default(cuid())
  accountId     String
  credentialType String
  data          String   @db.Text
  metadata      String   @db.Text
  history       String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model authSession {
  id                    String   @id @default(cuid())
  uuid                  String   @unique
  accountId             String
  account               account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status                String   @default("ACTIVE")
  accessToken           String   @unique
  accessTokenExpiresAt  DateTime
  refreshToken          String   @unique
  refreshTokenExpiresAt DateTime
  device                String
  ipAddress             String?
  userAgent             String?
  history               String   @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastAccessedAt        DateTime
  revokedAt             DateTime?
}

// ==================== Repository Models ====================

model repository {
  id        String   @id @default(cuid())
  uuid      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model resource {
  id        String   @id @default(cuid())
  uuid      String   @unique
  repositoryId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model folder {
  id        String   @id @default(cuid())
  uuid      String   @unique
  repositoryId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 资源书签 — 用户对资源的标记/别名
model resourceBookmark {
  id        String   @id @default(cuid())

  identityId String   @map("identity_id")
  resourceId String   @map("resource_id")

  aliasName  String?  @map("alias_name")
  icon       String?
  color      String?

  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([identityId, resourceId])
  @@index([identityId])
  @@index([resourceId])
  @@map("resource_bookmarks")
}

model repositoryStatistics {
  id        String   @id @default(cuid())
  uuid      String   @unique
  repositoryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

