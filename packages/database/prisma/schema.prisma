// ==================== Goal Models ====================

model goal {
  id        String   @id @default(cuid())
  uuid      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model goalKeyResult {
  id        String   @id @default(cuid())
  uuid      String   @unique
  goalId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snapshots keyResultWeightSnapshot[] @relation("keyResultWeightSnapshot")
}

model keyResultWeightSnapshot {
  id              String   @id @default(cuid())
  uuid            String   @unique
  keyResultId     String
  keyResult       goalKeyResult @relation("keyResultWeightSnapshot", fields: [keyResultId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

