{
  "name": "@dailyuse/database",
  "version": "0.0.1",
  "description": "Memoflow Shared Database Infrastructure — Prisma Schema, Client, and Connection Management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/generated/prisma/client.d.ts",
      "import": "./dist/generated/prisma/client.js",
      "default": "./dist/generated/prisma/client.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate --config ./prisma/prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.0",
    "dotenv-expand": "13.0.0",
    "prisma": "7.8.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
