{
  "name": "@dailyuse/database",
  "version": "0.0.1",
  "description": "DailyUse Shared Database Infrastructure — Prisma Schema, Client, and Connection Management",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./prisma": {
      "types": "./src/generated/prisma/client.d.ts",
      "import": "./src/generated/prisma/client.js"
    },
    "./powersync": {
      "types": "./src/powersync-schema.ts",
      "import": "./src/powersync-schema.ts"
    }
  },
  "scripts": {
    "postinstall": "prisma generate --config ./prisma/prisma.config.ts",
    "build": "pnpm run postinstall",
    "prisma:generate": "prisma generate --config ./prisma/prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config ./prisma/prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config ./prisma/prisma.config.ts",
    "prisma:migrate:reset": "prisma migrate reset --config ./prisma/prisma.config.ts",
    "prisma:studio": "prisma studio --config ./prisma/prisma.config.ts",
    "prisma:push": "prisma db push --config ./prisma/prisma.config.ts"
  },
  "dependencies": {
    "@powersync/common": "^1.47.0",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "^7.4.2",
    "pg": "8.18.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.0",
    "prisma": "^7.4.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "src"
  ],
  "sideEffects": false
}
