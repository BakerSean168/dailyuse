// =============================================================
// DailyUse Database Schema — Base Configuration
// =============================================================
//
// This file contains the generator and datasource configuration
// All model files in this folder will be automatically included
// =============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Account Module
// 账户聚合根
// ==========================================

model Account {
  id               String    @id
  identityId       String    @unique @map("identity_id") // 关联 AuthIdentity
  status           String    @default("ACTIVE") // AccountStatus: ACTIVE | INACTIVE | SUSPENDED | DELETED
  // profile
  profile          Json
  // settings
  settings         Json
  // email object value
  emailAddress     String    @unique @map("email_address") // jdoe@example.com
  emailIsVerified  Boolean   @default(false) @map("email_is_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  emailIsPrimary   Boolean   @default(false) @map("email_is_primary")
  // phone object value
  phoneCountryCode String?   @map("phone_country_code") // +86
  phoneNumber      String?   @map("phone_number") // 13800138000
  phoneFullNumber  String?   @map("phone_full_number") // +8613800138000 (E.164格式)
  phoneIsVerified  Boolean?  @default(false) @map("phone_is_verified")
  phoneVerifiedAt  DateTime? @map("phone_verified_at")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // 关联关系
  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // 关联的业务模块
  documents                       Document[]
  documentVersions                DocumentVersion[]
  editorWorkspaces                EditorWorkspace[]
  editorWorkspaceSessions         EditorWorkspaceSession[]
  editorWorkspaceSessionGroups    EditorWorkspaceSessionGroup[]
  editorWorkspaceSessionGroupTabs EditorWorkspaceSessionGroupTab[]
  focusSessions                   FocusSession[]
  focusModes                      FocusMode[]
  goals                           Goal[]
  goalFolders                     GoalFolder[]
  goalStatistics                  GoalStatistic?
  reminderGroups                  ReminderGroup[]
  reminderTemplates               ReminderTemplate[]
  reminderInstances               ReminderInstance[]
  reminderStatistics              ReminderStatistic?
  userReminderPreferences         UserReminderPreference?
  repositories                    Repository[]
  repositoryExplorers             RepositoryExplorer[]
  repositoryStatistics            RepositoryStatistic?
  schedules                       Schedule[]
  scheduleJobs                    ScheduleJob[]
  scheduleTasks                   ScheduleTask[]
  scheduleStatistics              ScheduleStatistic?
  settings_                       Setting[]
  taskFolders                     TaskFolder[]
  taskTemplates                   TaskTemplate[]
  taskInstances                   TaskInstance[]
  taskStatistics                  TaskStatistic?
  userSettings                    UserSetting?
  notifications                   Notification[]
  aiConversations                 AiConversation[]
  aiGenerationTasks               AiGenerationTask[]
  aiUsageQuotas                   AiUsageQuota?
  aiProviderConfigs               AiProviderConfig[]
  dashboardConfigs                DashboardConfig?
  syncProfiles                    SyncProfile[]
  syncSessions                    SyncSession[]
  syncConflicts                   SyncConflict[]
  pendingChanges                  PendingChange[]

  @@index([emailAddress])
  @@index([phoneFullNumber])
  @@index([identityId])
  @@map("accounts")
}

// ==========================================
// AI Module
// AI 对话、消息、生成任务、配额、Provider 配置
// ==========================================

model AiConversation {
  id            String    @id
  identityId    String    @map("identity_id")
  name          String
  status        String // ACTIVE, CLOSED, ARCHIVED
  messageCount  Int       @default(0) @map("message_count")
  lastMessageAt DateTime? @map("last_message_at")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  account  Account     @relation(fields: [identityId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([identityId])
  @@index([status])
  @@index([createdAt])
  @@index([lastMessageAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id
  conversationId String   @map("conversation_id")
  role           String // USER, ASSISTANT, SYSTEM
  content        String   @db.Text
  tokenUsage     String?  @map("token_usage") // JSON
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_messages")
}

model AiGenerationTask {
  id           String    @id
  identityId   String    @map("identity_id")
  taskType     String    @map("task_type") // GOAL_KEY_RESULTS, TASK_TEMPLATES, etc.
  status       String // PENDING, PROCESSING, COMPLETED, FAILED
  input        String    @db.Text // JSON string
  result       String?   @db.Text // JSON string
  error        String?   @db.Text
  retryCount   Int       @default(0) @map("retry_count")
  tokenUsage   String?   @map("token_usage") // JSON
  processingMs Int?      @map("processing_ms")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  completedAt  DateTime? @map("completed_at")
  deletedAt    DateTime? @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([taskType])
  @@index([status])
  @@index([createdAt])
  @@map("ai_generation_tasks")
}

model AiUsageQuota {
  id           String    @id
  identityId   String    @unique @map("identity_id")
  quotaLimit   Int       @default(50) @map("quota_limit")
  currentUsage Int       @default(0) @map("current_usage")
  resetPeriod  String    @default("DAILY") @map("reset_period") // DAILY, WEEKLY, MONTHLY
  lastResetAt  DateTime  @default(now()) @map("last_reset_at")
  nextResetAt  DateTime  @map("next_reset_at")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([nextResetAt])
  @@map("ai_usage_quotas")
}

model AiProviderConfig {
  id              String    @id
  identityId      String    @map("identity_id")
  name            String // 配置名称
  providerType    String    @map("provider_type") // OPENAI, QINIU, ANTHROPIC, CUSTOM_OPENAI_COMPATIBLE
  baseUrl         String    @map("base_url") // API 基础地址
  apiKeyEncrypted String    @map("api_key_encrypted") // AES-256-GCM 加密的 API Key
  defaultModel    String?   @map("default_model")
  availableModels String    @default("[]") @map("available_models") // 可用模型列表 JSON
  isActive        Boolean   @default(true) @map("is_active")
  isDefault       Boolean   @default(false) @map("is_default")
  priority        Int       @default(100) // 优先级
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, name])
  @@index([identityId])
  @@index([isDefault])
  @@index([isActive])
  @@index([priority])
  @@map("ai_provider_configs")
}

model KnowledgeGenerationTask {
  id                   String    @id
  identityId           String    @map("identity_id")
  topic                String
  documentCount        Int       @default(5) @map("document_count")
  targetAudience       String?   @map("target_audience")
  folderPath           String    @map("folder_path")
  status               String // PENDING, GENERATING, COMPLETED, FAILED
  progress             Int       @default(0) // 0-100
  generatedDocumentIds String[]  @map("generated_document_ids")
  error                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")

  @@index([identityId])
  @@index([status])
  @@index([createdAt])
  @@map("knowledge_generation_tasks")
}

model DashboardConfig {
  id           Int      @id @default(autoincrement())
  identityId   String   @unique @map("identity_id")
  widgetConfig Json     @map("widget_config")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("dashboard_configs")
}

// ==========================================
// App Config Module
// 应用配置
// ==========================================

model AppConfig {
  id          String   @id
  version     String   @unique
  config      String
  description String?
  isCurrent   Boolean  @default(false) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([version])
  @@map("app_configs")
}

// ==========================================
// Auth Module
// 认证聚合根、凭证、会话
// ==========================================

// 1. 使用枚举保持与领域层 Value Object 一致
enum AuthIdentityStatus {
  ACTIVE // 正常
  LOCKED // 多次尝试失败锁定
  DISABLED // 管理员禁用
  UNVERIFIED // 未验证
}

enum CredentialType {
  PASSWORD
  OAUTH
  PHONE
  MAGIC_LINK
  // PASSKEY // 未来扩展
}

enum CredentialStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED // 如：用户解绑了 Google，或者重置了密码导致旧凭证失效
}

// ==========================================
// 1. 身份聚合根表 (AuthIdentity)
// ==========================================
model AuthIdentity {
  id     String             @id @default(uuid())
  status AuthIdentityStatus @default(UNVERIFIED)

  // 安全风控字段 (对应聚合根内部状态)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedAttempt   DateTime? @map("last_failed_attempt")
  lockedUntil         DateTime? @map("locked_until")

  // 时间戳
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 关联
  credentials AuthCredential[]
  sessions    AuthSession[]
  accounts    Account[]

  @@map("auth_identities")
}

// ==========================================
// 2. 凭证实体表 (AuthCredential)
// 采用 "单表继承 (Single Table Inheritance)" 策略
// ==========================================
model AuthCredential {
  id String @id @default(uuid())

  // 归属的身份
  identityId String       @map("identity_id")
  identity   AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // 核心字段
  type   CredentialType
  status CredentialStatus @default(ACTIVE)

  // [Type: PASSWORD]
  identifier            String? // 邮箱 或 手机号 (用于快速查找)
  passwordHash          String?   @map("password_hash") // Argon2 hash
  passwordLastChangedAt DateTime? @map("password_last_changed_at") // 密码最后修改时间

  // [Type: OAUTH]
  provider          String? // GOOGLE, GITHUB (数据库存字符串，代码转枚举)
  providerSubjectId String?   @map("provider_subject_id") // 第三方返回的 sub / openid
  accessToken       String?   @map("access_token") // 视安全需求，可能需要加密存储
  refreshToken      String?   @map("refresh_token") // 视安全需求，可能需要加密存储
  oauthExpiresAt    DateTime? @map("oauth_expires_at") // Token 过期时间

  // [Type: PHONE]
  isVerified Boolean? @default(false) @map("is_verified")

  // 元数据
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  deletedAt  DateTime? @map("deleted_at")

  @@unique([identifier, type])
  @@unique([provider, providerSubjectId])
  @@index([identityId, type])
  @@map("auth_credentials")
}

// ==========================================
// 3. 会话聚合根表 (AuthSession)
// ==========================================
model AuthSession {
  id String @id @default(uuid())

  identityId String       @map("identity_id")
  identity   AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // 核心令牌数据
  refreshTokenHash String? @map("refresh_token_hash") // 支持 Refresh Token 轮换

  // 设备信息 (对应 DeviceInfo Value Object)
  deviceId          String  @map("device_id")
  deviceFingerprint String  @map("device_fingerprint")
  deviceType        String  @map("device_type") // MOBILE, DESKTOP
  deviceName        String? @map("device_name")
  os                String?
  browser           String?
  ipAddress         String? @map("ip_address")

  // 地理位置 (用 JSON 存比较灵活，因为字段不确定)
  location Json? // { country, city, timezone }

  // 生命周期
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([identityId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ==========================================
// Document Module
// 文档聚合根、版本、链接
// ==========================================

model Document {
  id              String    @id
  identityId      String    @map("identity_id")
  title           String
  content         String    @db.Text
  folderPath      String    @map("folder_path")
  tags            String[] // PostgreSQL array
  status          String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  currentVersion  Int       @default(0) @map("current_version")
  lastVersionedAt DateTime? @map("last_versioned_at")
  lastEditedAt    DateTime? @map("last_edited_at")
  editSessionId   String?   @map("edit_session_id")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  account     Account           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  versions    DocumentVersion[]
  sourceLinks DocumentLink[]    @relation("source_links")
  targetLinks DocumentLink[]    @relation("target_links")

  @@index([identityId, deletedAt])
  @@index([identityId, folderPath])
  @@index([identityId, status])
  @@map("documents")
}

model DocumentVersion {
  id                String   @id
  documentId        String   @map("document_id")
  versionNumber     Int      @map("version_number")
  title             String
  content           String   @db.Text
  changeType        String   @map("change_type") // initial | major | minor | patch | restore
  changeDescription String?  @map("change_description")
  changedBy         String   @map("changed_by")
  restoredFrom      String?  @map("restored_from")
  metadata          Json? // { addedChars, deletedChars, modifiedSections }
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [changedBy], references: [id])

  @@index([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([changedBy])
  @@map("document_versions")
}

model DocumentLink {
  id               String    @id
  sourceDocumentId String    @map("source_document_id")
  targetDocumentId String?   @map("target_document_id")
  linkText         String    @map("link_text")
  linkPosition     Int       @map("link_position")
  isBroken         Boolean   @default(false) @map("is_broken")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  sourceDocument Document  @relation("source_links", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocument Document? @relation("target_links", fields: [targetDocumentId], references: [id], onDelete: SetNull)

  @@index([sourceDocumentId])
  @@index([targetDocumentId])
  @@index([isBroken])
  @@map("document_links")
}

// ==========================================
// Editor Module
// 编辑器工作区、会话、标签页
// ==========================================

model EditorWorkspace {
  id          String    @id
  identityId  String    @map("identity_id")
  name        String
  description String?
  projectPath String    @unique @map("project_path")
  projectType String    @map("project_type")
  layout      Json
  setting     Json
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  accessedAt  DateTime  @default(now()) @map("accessed_at")
  deletedAt   DateTime? @map("deleted_at")

  sessions EditorWorkspaceSession[]
  account  Account                  @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("editor_workspaces")
}

model EditorWorkspaceSession {
  id          String    @id
  workspaceId String    @map("workspace_id")
  identityId  String    @map("identity_id")
  name        String
  layout      Json
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  groups    EditorWorkspaceSessionGroup[]
  account   Account                       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  workspace EditorWorkspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("editor_workspace_sessions")
}

model EditorWorkspaceSessionGroup {
  id             String    @id
  sessionId      String    @map("session_id")
  workspaceId    String    @map("workspace_id")
  identityId     String    @map("identity_id")
  groupIndex     Int       @map("group_index")
  name           String?
  splitDirection String    @map("split_direction")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  tabs    EditorWorkspaceSessionGroupTab[]
  account Account                          @relation(fields: [identityId], references: [id], onDelete: Cascade)
  session EditorWorkspaceSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("editor_workspace_session_groups")
}

model EditorWorkspaceSessionGroupTab {
  id          String    @id
  groupId     String    @map("group_id")
  sessionId   String    @map("session_id")
  workspaceId String    @map("workspace_id")
  identityId  String    @map("identity_id")
  documentId  String?   @map("document_id")
  tabIndex    Int       @map("tab_index")
  tabType     String    @map("tab_type")
  title       String
  viewState   Json      @map("view_state")
  isPinned    Boolean   @default(false) @map("is_pinned")
  isActive    Boolean   @default(false) @map("is_active")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  account Account                     @relation(fields: [identityId], references: [id], onDelete: Cascade)
  group   EditorWorkspaceSessionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("editor_workspace_session_group_tabs")
}

// ==========================================
// Goal Module
// 目标聚合根、关键结果、文件夹、记录、评审、统计
// ==========================================

/// Goal 聚合根 - 用户目标（OKR）
/// 管理目标的完整生命周期，包括状态、进度、关键结果等
model Goal {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @map("identity_id")

  // ============ 基础信息 ============
  name                String /// 目标名称（1-200字符）
  description         String? /// 详细描述（最多2000字符）
  color               String  @default("#3B82F6") /// UI 显示颜色（必需，默认蓝色）
  feasibilityAnalysis String? @map("feasibility_analysis") /// AI 可行性分析结果
  motivation          String? /// 目标动机说明

  // ============ 状态与优先级 ============
  status     String   @default("pending") /// 目标状态（pending/active/completed/archived）
  importance String   @default("moderate") /// 重要性级别（ImportanceLevel）
  priority   Int      @default(0) /// 动态计算的优先级分数（0-100，用于排序）
  category   String? /// 目标分类
  tags       String[] @default([]) /// 标签列表（最多20个，每个最多50字符）

  // ============ 时间管理 ============
  startDate   DateTime? @map("start_date") /// 开始日期
  targetDate  DateTime? @map("target_date") /// 目标完成日期
  completedAt DateTime? @map("completed_at") /// 实际完成时间
  archivedAt  DateTime? @map("archived_at") /// 归档时间

  // ============ 层级与组织 ============
  folderId     String? @map("folder_id") /// 所属文件夹
  parentGoalId String? @map("parent_goal_id") /// 父目标ID（支持目标层级）
  sortOrder    Int     @default(0) @map("sort_order") /// 排序顺序

  // ============ 扩展功能 ============
  reminderConfig String? @map("reminder_config") /// 提醒配置（JSON序列化）

  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  account                  Account                   @relation(fields: [identityId], references: [id], onDelete: Cascade)
  folder                   GoalFolder?               @relation(fields: [folderId], references: [id])
  parentGoal               Goal?                     @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childGoals               Goal[]                    @relation("GoalHierarchy")
  keyResults               KeyResult[] /// 关键结果列表（一对多，级联删除）
  reviews                  GoalReview[] /// 目标评审记录（一对多，级联删除）
  keyResultWeightSnapshots KeyResultWeightSnapshot[] /// KR权重快照（一对多，级联删除）
  focusSessions            FocusSession[] /// 专注会话记录（一对多，级联删除）

  // ============ 索引优化 ============
  @@index([identityId, status]) /// 按用户+状态查询（常用）
  @@index([identityId, targetDate]) /// 按用户+截止日期查询（日历视图）
  @@index([identityId, priority]) /// 按用户+优先级排序（列表视图）
  @@index([folderId]) /// 按文件夹查询
  @@index([parentGoalId]) /// 按父目标查询（层级视图）
  @@index([targetDate]) /// 按截止日期查询（全局日历）
  @@index([deletedAt]) /// 软删除过滤
  @@map("goals")
}

/// GoalFolder 聚合根 - 目标文件夹
/// 用于组织和分类目标，支持层级结构
model GoalFolder {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @map("identity_id")

  // ============ 基础信息 ============
  name        String /// 文件夹名称
  description String? /// 描述说明
  color       String? /// 显示颜色
  icon        String? /// 图标标识

  // ============ 文件夹特性 ============
  folderType     String? @map("folder_type") /// 文件夹类型（系统/用户）
  isSystemFolder Boolean @default(false) @map("is_system_folder") /// 是否为系统文件夹
  parentFolderId String? @map("parent_folder_id") /// 父文件夹ID（支持嵌套）
  sortOrder      Int     @default(0) @map("sort_order") /// 排序顺序

  // ============ 统计信息（冗余字段，提升查询性能） ============
  goalCount          Int @default(0) @map("goal_count") /// 目标总数
  completedGoalCount Int @default(0) @map("completed_goal_count") /// 已完成目标数

  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  account      Account      @relation(fields: [identityId], references: [id], onDelete: Cascade)
  parentFolder GoalFolder?  @relation("GoalFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childFolders GoalFolder[] @relation("GoalFolderHierarchy") /// 子文件夹列表
  goals        Goal[] /// 包含的目标列表

  // ============ 索引优化 ============
  @@index([identityId]) /// 按用户查询
  @@index([parentFolderId]) /// 按父文件夹查询（层级视图）
  @@index([identityId, isSystemFolder]) /// 用户文件夹分类查询
  @@map("goal_folders")
}

/// KeyResult 实体 - 关键结果
/// 衡量目标进度的具体指标（OKR 中的 KR）
model KeyResult {
  // ============ 主键与外键 ============
  id     String @id
  goalId String @map("goal_id")

  // ============ 基础信息 ============
  title       String /// KR 标题
  description String? /// 详细说明

  // ============ 度量配置 ============
  valueType         String  @map("value_type") /// 数值类型（numeric/boolean/percentage）
  aggregationMethod String  @map("aggregation_method") /// 聚合方法（sum/average/latest）
  targetValue       Float   @map("target_value") /// 目标值
  currentValue      Float   @default(0) @map("current_value") /// 当前值（冗余字段，提升查询性能）
  unit              String? /// 单位（如：个、%、小时）

  // ============ 权重与排序 ============
  weight Float @default(1) /// 权重系数（计算目标进度时使用）
  order  Int   @default(0) /// 显示顺序

  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  goal                     Goal                      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  records                  GoalRecord[] /// 记录历史数据（一对多，级联删除）
  keyResultWeightSnapshots KeyResultWeightSnapshot[] /// 权重变更快照（一对多，级联删除）

  // ============ 索引优化 ============
  @@index([goalId]) /// 按目标查询KR列表
  @@index([goalId, order]) /// 按目标查询并按顺序排序
  @@map("key_results")
}

/// GoalRecord 实体 - 关键结果记录
/// 记录 KR 的历史数据点，用于趋势分析和进度跟踪
model GoalRecord {
  // ============ 主键与外键 ============
  id          String @id
  keyResultId String @map("key_result_id")

  // ============ 记录数据 ============
  value      Float /// 记录的数值
  note       String? /// 备注说明
  recordedAt DateTime @map("recorded_at") /// 记录时间（业务时间，非创建时间）

  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  // ============ 索引优化 ============
  @@index([keyResultId, recordedAt]) /// 按KR查询时间序列数据（常用）
  @@index([recordedAt]) /// 按时间查询全局记录
  @@map("goal_records")
}

/// GoalReview 实体 - 目标评审
/// 记录目标的回顾与反思（复盘）
model GoalReview {
  // ============ 主键与外键 ============
  id     String @id
  goalId String @map("goal_id")

  // ============ 评审内容 ============
  reviewType     String  @map("review_type") /// 评审类型（weekly/monthly/milestone/completion）
  content        String /// 主要内容
  achievements   String? /// 成就总结
  challenges     String? /// 遇到的挑战
  lessonsLearned String? @map("lessons_learned") /// 经验教训
  nextSteps      String? @map("next_steps") /// 下一步计划
  rating         Int? /// 评分（1-5星）

  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // ============ 索引优化 ============
  @@index([goalId, createdAt]) /// 按目标查询评审时间线（常用）
  @@index([reviewType]) /// 按评审类型分类查询
  @@map("goal_reviews")
}

/// KeyResultWeightSnapshot 值对象 - KR权重快照
/// 记录关键结果权重的历史变更，用于审计和回溯分析
model KeyResultWeightSnapshot {
  // ============ 主键与外键 ============
  id          String @id
  goalId      String @map("goal_id")
  keyResultId String @map("key_result_id")

  // ============ 权重变更数据 ============
  oldWeight   Float @map("old_weight") /// 旧权重值
  newWeight   Float @map("new_weight") /// 新权重值
  weightDelta Float @map("weight_delta") /// 权重变化量（新-旧）

  // ============ 变更元数据 ============
  snapshotTime DateTime @map("snapshot_time") /// 快照时间
  trigger      String /// 触发原因（manual/auto/normalize）
  reason       String? /// 变更原因说明
  operatorId   String   @map("operator_id") /// 操作人ID

  // ============ 审计 ============
  createdAt DateTime @default(now()) @map("created_at")

  // ============ 关系映射 ============
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  // ============ 索引优化 ============
  @@index([goalId, snapshotTime]) /// 按目标查询权重变更历史（常用）
  @@index([keyResultId, snapshotTime]) /// 按KR查询权重变更历史
  @@index([snapshotTime]) /// 按时间查询全局快照
  @@map("key_result_weight_snapshots")
}

/// FocusSession 聚合根 - 专注会话
/// 管理番茄钟/专注时间的完整生命周期，支持暂停/恢复/完成等状态转换
model FocusSession {
  // ============ 主键与外键 ============
  id         String  @id
  identityId String  @map("identity_id")
  goalId     String? @map("goal_id") /// 关联的目标ID（可选）

  // ============ 状态与时长 ============
  status                String  @default("Active") /// 会话状态（Active/Completed/Cancelled）
  durationMinutes       Int     @map("duration_minutes") /// 计划时长（分钟）
  actualDurationMinutes Int     @default(0) @map("actual_duration_minutes") /// 实际时长（分钟，排除暂停）
  description           String? /// 会话描述/备注

  // ============ 时间追踪 ============
  startedAt   DateTime? @map("started_at") /// 开始时间
  pausedAt    DateTime? @map("paused_at") /// 最后暂停时间
  resumedAt   DateTime? @map("resumed_at") /// 最后恢复时间
  completedAt DateTime? @map("completed_at") /// 完成时间
  cancelledAt DateTime? @map("cancelled_at") /// 取消时间

  // ============ 暂停统计 ============
  pauseCount            Int @default(0) @map("pause_count") /// 暂停次数
  pausedDurationMinutes Int @default(0) @map("paused_duration_minutes") /// 累计暂停时长（分钟）

  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)
  goal    Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull) /// 目标删除时解除关联

  // ============ 索引优化 ============
  @@index([identityId, status]) /// 按用户+状态查询（常用）
  @@index([identityId, createdAt]) /// 按用户+时间查询（统计分析）
  @@index([goalId]) /// 按目标查询专注记录
  @@index([status]) /// 按状态查询（全局统计）
  @@index([completedAt]) /// 按完成时间查询（报表统计）
  @@map("focus_sessions")
}

/// FocusMode 值对象 - 专注模式
/// 用户在特定时间段内聚焦于少数目标（1-3个），隐藏其他目标以减少干扰
model FocusMode {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @map("identity_id")

  // ============ 聚焦配置 ============
  focusedGoalIds  String[] @map("focused_goal_ids") /// 聚焦的目标ID列表（1-3个）
  hiddenGoalsMode String   @map("hidden_goals_mode") /// 隐藏模式（hide/dim/collapse）

  // ============ 时间范围 ============
  startTime     DateTime  @map("start_time") /// 开始时间
  endTime       DateTime  @map("end_time") /// 计划结束时间
  actualEndTime DateTime? @map("actual_end_time") /// 实际结束时间（提前结束或延长）

  // ============ 状态 ============
  isActive Boolean @default(true) @map("is_active") /// 是否激活中

  // ============ 版本与审计 ============
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ============ 关系映射 ============
  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // ============ 索引优化 ============
  @@index([identityId, isActive]) /// 按用户查询激活状态（常用）
  @@index([identityId, endTime]) /// 按用户+结束时间查询（历史记录）
  @@index([isActive]) /// 查询全局激活的专注模式
  @@index([endTime]) /// 按结束时间查询（清理过期模式）
  @@map("focus_modes")
}

/// GoalStatistic 值对象 - 目标统计
/// 缓存目标模块的统计数据，定期更新
model GoalStatistic {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @unique @map("identity_id")

  // ============ 目标统计 ============
  totalGoals     Int @default(0) @map("total_goals")
  activeGoals    Int @default(0) @map("active_goals")
  completedGoals Int @default(0) @map("completed_goals")
  archivedGoals  Int @default(0) @map("archived_goals")

  // ============ KR 统计 ============
  totalKeyResults     Int @default(0) @map("total_key_results")
  completedKeyResults Int @default(0) @map("completed_key_results")

  // ============ 专注统计 ============
  totalFocusSessions Int @default(0) @map("total_focus_sessions")
  totalFocusMinutes  Int @default(0) @map("total_focus_minutes")

  // ============ 评审统计 ============
  totalReviews  Int    @default(0) @map("total_reviews")
  averageRating Float? @map("average_rating")

  // ============ 时间 ============
  calculatedAt DateTime @map("calculated_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // ============ 关系映射 ============
  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // ============ 索引优化 ============
  @@index([identityId])
  @@map("goal_statistics")
}

// ==========================================
// Governance Module
// 规则管理、规则修订记录
// ==========================================

// ==========================================
// 1. 规则聚合根表 (Rule)
// ==========================================
model Rule {
  id          String @id @default(uuid())
  code        String @unique // 规则编码，格式：PREFIX-NUMBER (e.g., DDD-001)
  title       String // 规则标题
  description String // 规则描述

  severity String @default("Recommended") // Mandatory | Recommended
  status   String @default("Draft") // Draft | Active | Deprecated

  deprecationReason     String? @map("deprecation_reason")
  replacementRuleId     String? @map("replacement_rule_id")
  liveReferenceLocation String? @map("live_reference_location")

  // JSON fields
  tags         String // JSON array of tag strings
  goodExamples String @map("good_examples") // JSON array of code snippets
  badExamples  String @map("bad_examples") // JSON array of code snippets

  authorId String @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  revisions RuleRevision[]

  @@map("rules")
}

// ==========================================
// 2. 规则修订记录表 (RuleRevision)
// ==========================================
model RuleRevision {
  id             String @id @default(uuid())
  ruleId         String @map("rule_id")
  revisionNumber Int    @map("revision_number")

  authorId       String  @map("author_id")
  changedFields  String  @map("changed_fields") // JSON array
  previousValues String? @map("previous_values") // JSON object
  newValues      String? @map("new_values") // JSON object
  changeType     String  @map("change_type") // Created | Updated | Deprecated | Reactivated

  createdAt DateTime @default(now()) @map("created_at")

  // 关联
  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, revisionNumber])
  @@map("rule_revisions")
}

// ==========================================
// Notification Module
// 通知聚合根、渠道、历史、偏好、模板
// ==========================================

model Notification {
  id                String    @id
  identityId        String    @map("identity_id")
  type              String
  category          String
  status            String
  title             String
  content           String
  importance        String
  urgency           String
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id")
  metadata          String?
  actions           String?
  readAt            DateTime? @map("read_at")
  sentAt            DateTime? @map("sent_at")
  expiresAt         DateTime? @map("expires_at")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  isRead            Boolean   @default(false) @map("is_read")

  channels NotificationChannel[]
  history  NotificationHistory[]
  account  Account               @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("notifications")
}

model NotificationChannel {
  id             String  @id
  notificationId String  @map("notification_id")
  channelType    String  @map("channel_type")
  status         String
  recipient      String?
  maxRetries     Int     @default(3) @map("max_retries")
  error          String?
  response       String?
  retryCount     Int     @default(0) @map("retry_count")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_channels")
}

model NotificationHistory {
  id             String   @id
  notificationId String   @map("notification_id")
  action         String
  details        String?
  actorId        String?  @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_history")
}

model NotificationPreference {
  id           String    @id
  identityId   String    @unique @map("identity_id")
  enabled      Boolean   @default(true)
  channels     String
  categories   String
  doNotDisturb String?   @map("do_not_disturb")
  rateLimit    String?   @map("rate_limit")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([identityId])
  @@map("notification_preferences")
}

model NotificationTemplate {
  id              String   @id
  name            String   @unique
  displayName     String   @map("display_name")
  description     String?
  type            String
  category        String
  titleTemplate   String   @map("title_template")
  contentTemplate String   @map("content_template")
  variables       String?
  defaultActions  String?  @map("default_actions")
  isSystem        Boolean  @default(false) @map("is_system")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("notification_templates")
}

// ==========================================
// Reminder Module
// 提醒模板、实例、分组、历史、统计、响应
// ==========================================

model ReminderTemplate {
  id                 String    @id
  identityId         String    @map("identity_id")
  name               String
  description        String?
  type               String
  selfEnabled        Boolean   @map("self_enabled")
  status             String
  reminderGroupId    String?   @map("reminder_group_id")
  importanceLevel    String    @map("importance_level")
  tags               String
  color              String?
  icon               String?
  nextTriggerAt      DateTime? @map("next_trigger_at")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  trigger            String
  recurrence         String?
  activeTime         String    @map("active_time")
  activeHours        String?   @map("active_hours")
  notificationConfig String    @map("notification_config")
  stats              String

  // Smart Frequency: Response Metrics
  clickRate          Float?    @map("click_rate")
  ignoreRate         Float?    @map("ignore_rate")
  avgResponseTime    Int?      @map("avg_response_time")
  snoozeCount        Int       @default(0) @map("snooze_count")
  effectivenessScore Float?    @map("effectiveness_score")
  sampleSize         Int       @default(0) @map("sample_size")
  lastAnalysisTime   DateTime? @map("last_analysis_time")

  // Smart Frequency: Frequency Adjustment
  originalInterval      Int?      @map("original_interval")
  adjustedInterval      Int?      @map("adjusted_interval")
  adjustmentReason      String?   @map("adjustment_reason")
  adjustmentTime        DateTime? @map("adjustment_time")
  isAutoAdjusted        Boolean   @default(false) @map("is_auto_adjusted")
  userConfirmed         Boolean   @default(false) @map("user_confirmed")
  smartFrequencyEnabled Boolean   @default(true) @map("smart_frequency_enabled")

  history   ReminderHistory[]
  instances ReminderInstance[]
  responses ReminderResponse[]
  account   Account            @relation(fields: [identityId], references: [id], onDelete: Cascade)
  group     ReminderGroup?     @relation(fields: [reminderGroupId], references: [id])

  @@index([status])
  @@map("reminder_templates")
}

model ReminderGroup {
  id          String    @id
  identityId  String    @map("identity_id")
  name        String
  description String?
  color       String?
  icon        String?
  controlMode String    @map("control_mode")
  enabled     Boolean
  status      String
  order       Int
  stats       String
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  account   Account            @relation(fields: [identityId], references: [id], onDelete: Cascade)
  templates ReminderTemplate[]

  @@index([identityId])
  @@map("reminder_groups")
}

model ReminderInstance {
  id          String    @id
  templateId  String    @map("template_id")
  identityId  String    @map("identity_id")
  triggerAt   DateTime  @map("trigger_at")
  status      String
  result      String?
  processedAt DateTime? @map("processed_at")
  note        String?
  payload     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account  Account          @relation(fields: [identityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([triggerAt])
  @@map("reminder_instances")
}

model ReminderHistory {
  id                  String   @id
  templateId          String   @map("template_id")
  triggeredAt         DateTime @map("triggered_at")
  result              String
  error               String?
  notificationSent    Boolean  @map("notification_sent")
  notificationChannel String?
  createdAt           DateTime @default(now()) @map("created_at")

  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("reminder_history")
}

model ReminderStatistic {
  id            String   @id
  identityId    String   @unique @map("identity_id")
  templateStats String   @map("template_stats")
  groupStats    String   @map("group_stats")
  triggerStats  String   @map("trigger_stats")
  calculatedAt  DateTime @map("calculated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("reminder_statistics")
}

model ReminderResponse {
  id           String   @id @default(uuid())
  templateId   String   @map("template_id")
  action       String // clicked, ignored, snoozed, dismissed, completed
  responseTime Int?     @map("response_time") // seconds
  timestamp    DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  template ReminderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, timestamp(sort: Desc)])
  @@map("reminder_responses")
}

/// UserReminderPreference 聚合根 - 用户提醒偏好
/// 存储用户的最佳/最差响应时间段和智能频率配置
model UserReminderPreference {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @unique @map("identity_id")

  // ============ 时间段偏好 ============
  bestTimeSlots  String @map("best_time_slots") /// JSON: TimeSlotDTO[]
  worstTimeSlots String @map("worst_time_slots") /// JSON: TimeSlotDTO[]

  // ============ 智能频率 ============
  globalSmartFrequency Boolean @default(true) @map("global_smart_frequency")

  // ============ 审计 ============
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ============ 关系映射 ============
  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // ============ 索引优化 ============
  @@index([identityId])
  @@map("user_reminder_preferences")
}

// ==========================================
// Repository Module
// 仓库聚合根、资源、文件夹、浏览器、统计
// ==========================================

model Repository {
  id             String    @id
  identityId     String    @map("identity_id")
  name           String
  type           String
  path           String
  description    String?
  config         Json      @default("{}") // RepositoryConfig JSONB
  stats          Json      @default("{}") // RepositoryStats JSONB
  relatedGoals   String?   @map("related_goals")
  status         String    @default("ACTIVE") // ACTIVE | ARCHIVED | DELETED
  git            String?
  syncStatus     String?   @map("sync_status")
  lastAccessedAt DateTime? @map("last_accessed_at")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  account             Account              @relation(fields: [identityId], references: [id], onDelete: Cascade)
  explorers           RepositoryExplorer[]
  repositoryResources RepositoryResource[]
  resources           Resource[]
  folders             Folder[]

  @@unique([identityId, path])
  @@index([type])
  @@index([status])
  @@map("repositories")
}

model Folder {
  id           String   @id
  repositoryId String   @map("repository_id")
  parentId     String?  @map("parent_id")
  name         String
  path         String // Auto-generated: /parent/name
  order        Int      @default(0)
  isExpanded   Boolean  @default(true) @map("is_expanded")
  metadata     Json     @default("{}") // FolderMetadata JSONB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  parent     Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]   @relation("FolderHierarchy")

  @@unique([repositoryId, parentId, name])
  @@index([repositoryId])
  @@index([parentId])
  @@index([path])
  @@map("folders")
}

model Resource {
  id           String    @id
  repositoryId String    @map("repository_id")
  folderId     String?   @map("folder_id")
  name         String
  type         String // markdown | image | video | audio | pdf | link | code | other
  path         String
  size         Int       @default(0)
  content      String?   @db.Text
  metadata     Json      @default("{}") // ResourceMetadata
  stats        Json      @default("{}") // ResourceStats
  description  String?
  author       String?
  version      String?
  tags         String    @default("[]") // JSON array
  category     String?
  status       String    @default("ACTIVE") // ACTIVE | ARCHIVED | DELETED | DRAFT
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  modifiedAt   DateTime? @map("modified_at")
  deletedAt    DateTime? @map("deleted_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([folderId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("resources")
}

model RepositoryResource {
  id           String    @id
  repositoryId String    @map("repository_id")
  name         String
  type         String
  path         String
  size         Int?
  description  String?
  author       String?
  version      String?
  tags         String?
  category     String?
  status       String    @default("active")
  metadata     String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  modifiedAt   DateTime? @map("modified_at")

  linkedContents LinkedContent[]
  repository     Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sourceRefs     ResourceReference[] @relation("SourceResourceRefs")
  targetRefs     ResourceReference[] @relation("TargetResourceRefs")

  @@unique([repositoryId, path])
  @@index([type])
  @@map("repository_resources")
}

model LinkedContent {
  id            String    @id
  resourceId    String    @map("resource_id")
  title         String
  url           String
  contentType   String    @map("content_type")
  description   String?
  thumbnail     String?
  author        String?
  publishedAt   DateTime? @map("published_at")
  isAccessible  Boolean   @default(true) @map("is_accessible")
  lastCheckedAt DateTime? @map("last_checked_at")
  cachedAt      DateTime? @map("cached_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  repositoryResource RepositoryResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([url])
  @@map("linked_contents")
}

model ResourceReference {
  id               String    @id
  sourceResourceId String    @map("source_resource_id")
  targetResourceId String    @map("target_resource_id")
  referenceType    String    @map("reference_type")
  description      String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastVerifiedAt   DateTime? @map("last_verified_at")

  sourceResource RepositoryResource @relation("SourceResourceRefs", fields: [sourceResourceId], references: [id], onDelete: Cascade)
  targetResource RepositoryResource @relation("TargetResourceRefs", fields: [targetResourceId], references: [id], onDelete: Cascade)

  @@unique([sourceResourceId, targetResourceId, referenceType])
  @@index([targetResourceId])
  @@map("resource_references")
}

model RepositoryExplorer {
  id           String    @id
  repositoryId String    @map("repository_id")
  identityId   String    @map("identity_id")
  name         String
  description  String?
  currentPath  String    @map("current_path")
  filters      String?
  viewConfig   String?   @map("view_config")
  pinnedPaths  String?   @map("pinned_paths")
  recentPaths  String?   @map("recent_paths")
  lastScanAt   DateTime? @map("last_scan_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  account    Account    @relation(fields: [identityId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, identityId])
  @@index([repositoryId])
  @@map("repository_explorers")
}

model RepositoryStatistic {
  id                   Int      @id @default(autoincrement())
  identityId           String   @unique @map("identity_id")
  totalRepositories    Int      @default(0) @map("total_repositories")
  activeRepositories   Int      @default(0) @map("active_repositories")
  archivedRepositories Int      @default(0) @map("archived_repositories")
  totalResources       Int      @default(0) @map("total_resources")
  totalFiles           Int      @default(0) @map("total_files")
  totalFolders         Int      @default(0) @map("total_folders")
  gitEnabledRepos      Int      @default(0) @map("git_enabled_repos")
  totalCommits         Int      @default(0) @map("total_commits")
  totalReferences      Int      @default(0) @map("total_references")
  totalLinkedContents  Int      @default(0) @map("total_linked_contents")
  totalSizeBytes       BigInt   @default(0) @map("total_size_bytes")
  lastUpdatedAt        DateTime @default(now()) @map("last_updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("repository_statistics")
}

// ==========================================
// Schedule Module
// 日程聚合根、调度任务、调度作业、执行、统计
// ==========================================

model Schedule {
  id                   String   @id
  identityId           String   @map("identity_id")
  title                String
  description          String?
  startTime            DateTime @map("start_time")
  endTime              DateTime @map("end_time")
  duration             Int
  hasConflict          Boolean  @default(false) @map("has_conflict")
  conflictingSchedules String?  @map("conflicting_schedules")
  priority             Int?
  location             String?
  attendees            String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([startTime, endTime])
  @@map("schedules")
}

/// ScheduleJob 聚合根 - 调度作业
/// 跨模块的调度触发器，关联到业务模块的具体资源
model ScheduleJob {
  // ============ 主键与外键 ============
  id         String @id
  identityId String @map("identity_id")

  // ============ 调度配置 ============
  nextRunAt      DateTime @map("next_run_at")
  cronExpression String?  @map("cron_expression")

  // ============ 来源 ============
  sourceModule String @map("source_module") /// 来源模块
  sourceId     String @map("source_id") /// 来源实体ID

  // ============ 触发配置 ============
  triggerEvent String  @map("trigger_event")
  payload      String? /// JSON: Record<string, any>

  // ============ 审计 ============
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ============ 关系映射 ============
  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // ============ 索引优化 ============
  @@index([identityId])
  @@index([nextRunAt])
  @@index([sourceModule, sourceId])
  @@map("schedule_jobs")
}

model ScheduleTask {
  id                    String    @id
  identityId            String    @map("identity_id")
  name                  String
  description           String?
  sourceModule          String    @map("source_module")
  sourceEntityId        String    @map("source_entity_id")
  status                String
  enabled               Boolean
  cronExpression        String?   @map("cron_expression")
  timezone              String
  startDate             DateTime? @map("start_date")
  endDate               DateTime? @map("end_date")
  maxExecutions         Int?      @map("max_executions")
  nextRunAt             DateTime? @map("next_run_at")
  lastRunAt             DateTime? @map("last_run_at")
  executionCount        Int       @default(0) @map("execution_count")
  lastExecutionStatus   String?   @map("last_execution_status")
  lastExecutionDuration Int?      @map("last_execution_duration")
  consecutiveFailures   Int       @default(0) @map("consecutive_failures")
  maxRetries            Int       @map("max_retries")
  initialDelayMs        Int       @map("initial_delay_ms")
  maxDelayMs            Int       @map("max_delay_ms")
  backoffMultiplier     Float     @map("backoff_multiplier")
  retryableStatuses     String    @default("[]") @map("retryable_statuses")
  payload               String?
  tags                  String    @default("[]")
  priority              String
  timeout               Int?
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  executions ScheduleExecution[]
  account    Account             @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("schedule_tasks")
}

model ScheduleExecution {
  id            String   @id
  taskId        String   @map("task_id")
  executionTime DateTime @map("execution_time")
  status        String
  duration      Int?
  result        String?
  error         String?
  retryCount    Int      @default(0) @map("retry_count")
  createdAt     DateTime @default(now()) @map("created_at")

  task ScheduleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("schedule_executions")
}

model ScheduleStatistic {
  id                   Int      @id @default(autoincrement())
  identityId           String   @unique @map("identity_id")
  totalTasks           Int      @map("total_tasks")
  activeTasks          Int      @map("active_tasks")
  pausedTasks          Int      @map("paused_tasks")
  completedTasks       Int      @map("completed_tasks")
  cancelledTasks       Int      @map("cancelled_tasks")
  failedTasks          Int      @map("failed_tasks")
  totalExecutions      Int      @map("total_executions")
  successfulExecutions Int      @map("successful_executions")
  failedExecutions     Int      @map("failed_executions")
  skippedExecutions    Int      @map("skipped_executions")
  timeoutExecutions    Int      @map("timeout_executions")
  avgExecutionDuration Float    @map("avg_execution_duration")
  minExecutionDuration Float    @map("min_execution_duration")
  maxExecutionDuration Float    @map("max_execution_duration")
  moduleStatistics     String   @default("{}") @map("module_statistics")
  lastUpdatedAt        DateTime @map("last_updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("schedule_statistics")
}

// ==========================================
// Setting Module
// 设置聚合根、分组、项目、用户设置
// ==========================================

model Setting {
  id              String    @id
  key             String
  name            String
  description     String?
  valueType       String    @map("value_type")
  value           String
  defaultValue    String    @map("default_value")
  scope           String
  identityId      String?   @map("identity_id")
  deviceId        String?   @map("device_id")
  groupId         String?   @map("group_id")
  validation      String?
  ui              String?
  isEncrypted     Boolean   @default(false) @map("is_encrypted")
  isReadOnly      Boolean   @default(false) @map("is_read_only")
  isSystemSetting Boolean   @default(false) @map("is_system_setting")
  syncConfig      String?   @map("sync_config")
  historyData     String    @default("[]") @map("history_data")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  account Account?      @relation(fields: [identityId], references: [id], onDelete: Cascade)
  group   SettingGroup? @relation(fields: [groupId], references: [id])

  @@unique([key, scope, identityId, deviceId])
  @@index([scope])
  @@map("settings")
}

model SettingGroup {
  id          String    @id
  key         String    @unique
  name        String
  description String?
  parentId    String?   @map("parent_id")
  order       Int       @default(0)
  icon        String?
  isCollapsed Boolean   @default(false) @map("is_collapsed")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent   SettingGroup?  @relation("SettingGroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children SettingGroup[] @relation("SettingGroupHierarchy")
  items    SettingItem[]
  settings Setting[]

  @@index([parentId])
  @@map("setting_groups")
}

model SettingItem {
  id          String    @id
  groupId     String    @map("group_id")
  settingKey  String    @map("setting_key")
  order       Int       @default(0)
  isVisible   Boolean   @default(true) @map("is_visible")
  customLabel String?   @map("custom_label")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  group SettingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, settingKey])
  @@index([settingKey])
  @@map("setting_items")
}

model UserSetting {
  id                          String    @id
  identityId                  String    @unique @map("identity_id")
  version                     Int       @default(1)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  deletedAt                   DateTime? @map("deleted_at")
  appearanceAccentColor       String    @default("#3B82F6") @map("appearance_accent_color")
  appearanceCompactMode       Boolean   @default(false) @map("appearance_compact_mode")
  appearanceFontFamily        String?   @map("appearance_font_family")
  appearanceFontSize          String    @default("MEDIUM") @map("appearance_font_size")
