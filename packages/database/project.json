{
  "name": "database",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/database/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:infrastructure", "platform:server", "layer:infra"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/generated/prisma", "{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "cwd": "packages/database",
        "command": "prisma generate --config ./prisma/prisma.config.ts && tsc --build && node ../../tools/build/copy-with-retry.mjs src/generated/prisma dist/generated/prisma"
      },
      "inputs": [
        "{projectRoot}/prisma/schema/**/*",
        "{projectRoot}/prisma/prisma.config.ts",
        "{projectRoot}/src/**/*.ts"
      ],
      "cache": true
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["prisma-generate"],
      "options": {
        "cwd": "packages/database",
        "command": "tsc --build && node ../../tools/build/copy-with-retry.mjs src/generated/prisma dist/generated/prisma"
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/generated/prisma"],
      "options": {
        "cwd": "packages/database",
        "command": "prisma generate --config ./prisma/prisma.config.ts"
      },
      "inputs": ["{projectRoot}/prisma/schema/**/*", "{projectRoot}/prisma/prisma.config.ts"],
      "cache": true
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/database/**/*.ts"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/database"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "inputs": ["default", "^production"],
      "cache": true,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
        "cwd": "packages/database"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.ts",
        "cwd": "packages/database"
      }
    },
    "prisma-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/database",
        "command": "prisma migrate dev --config ./prisma/prisma.config.ts"
      },
      "cache": false
    },
    "prisma-migrate-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/database",
        "command": "prisma migrate deploy --config ./prisma/prisma.config.ts"
      },
      "cache": false
    },
    "prisma-migrate-reset": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/database",
        "command": "prisma migrate reset --config ./prisma/prisma.config.ts"
      },
      "cache": false
    },
    "prisma-studio": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/database",
        "command": "prisma studio --config ./prisma/prisma.config.ts"
      },
      "cache": false
    },
    "prisma-push": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/database",
        "command": "tsx ./scripts/prepare-ai-knowledge-index-pgvector.ts && prisma db push --config ./prisma/prisma.config.ts"
      },
      "cache": false
    },
    "ai-knowledge-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/database",
        "command": "tsx ./scripts/verify-ai-knowledge-index.ts"
      },
      "cache": false
    },
    "ai-knowledge-bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/database",
        "command": "tsx ./scripts/bootstrap-ai-knowledge-index.ts"
      },
      "cache": false
    },
    "editor-workspace-natural-key-bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/database",
        "command": "tsx ./scripts/prepare-editor-workspace-natural-key.ts"
      },
      "cache": false
    }
  }
}
