FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim AS builder

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=dev

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app

COPY apps/ai-service/pyproject.toml ./apps/ai-service/pyproject.toml
COPY apps/ai-service/uv.lock ./apps/ai-service/uv.lock

RUN uv sync --project ./apps/ai-service --frozen --no-dev --extra llm --no-install-project

COPY apps/ai-service/src ./apps/ai-service/src

FROM python:3.11-slim AS runtime

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=dev

ENV NODE_ENV=production
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONPATH=/app/apps/ai-service/src

LABEL org.opencontainers.image.title="dailyuse-ai-service"
LABEL org.opencontainers.image.description="DailyUse production AI service"
LABEL org.opencontainers.image.created=$BUILD_DATE
LABEL org.opencontainers.image.revision=$VCS_REF
LABEL org.opencontainers.image.version=$VERSION

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY apps/ai-service/src ./apps/ai-service/src

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; import sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8100/healthz').status == 200 else 1)"

CMD ["uvicorn", "ai_service.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8100"]
