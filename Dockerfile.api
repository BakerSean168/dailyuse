FROM node:24-bookworm-slim AS builder

ARG PNPM_VERSION=11.12.0

ENV CI=true
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
# Root postinstall runs tools/mcp/ensure-nx-src-link.mjs (nx-mcp symlink helper).
COPY tools/mcp ./tools/mcp

RUN pnpm install --frozen-lockfile

FROM node:24-bookworm-slim AS runtime

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=dev

ENV NODE_ENV=production
ENV CI=true
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH

LABEL org.opencontainers.image.title="dailyuse-api"
LABEL org.opencontainers.image.description="DailyUse production API service"
LABEL org.opencontainers.image.created=$BUILD_DATE
LABEL org.opencontainers.image.revision=$VCS_REF
LABEL org.opencontainers.image.version=$VERSION

RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/tsconfig.base.json ./tsconfig.base.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api ./apps/api
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules

RUN chmod +x /app/apps/api/scripts/*.sh

WORKDIR /app/apps/api

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('node:http').get('http://127.0.0.1:3000/healthz', (res) => process.exit(res.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["sh", "-c", "sh ./scripts/run-migrations.sh && node --import tsx dist/main.js"]
