{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "channel": "",
      "headless": true,
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-gpu",
        "--disable-dev-shm-usage"
      ]
    },
    "contextOptions": {
      "viewport": { "width": 1280, "height": 720 }
    }
  },
  "capabilities": ["core"],
  "saveTrace": true,
  "outputDir": "./tmp/playwright-mcp",
  "outputMode": "file",
  "network": {
    "allowedOrigins": ["http://localhost:*", "http://127.0.0.1:*"]
  },
  "timeouts": {
    "action": 15000,
    "navigation": 60000
  }
}
