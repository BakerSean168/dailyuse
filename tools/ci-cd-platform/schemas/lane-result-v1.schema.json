{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoflow.dev/schemas/lane-result-v1.schema.json",
  "type": "object",
  "required": [
    "kind",
    "version",
    "lane",
    "commit",
    "manifestDigest",
    "status",
    "failure",
    "timing",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "lane-result-v1" },
    "version": { "const": 1 },
    "lane": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["success", "failure", "cancelled", "skipped"] },
    "failure": { "type": "object" },
    "timing": { "type": "object" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": true
}
