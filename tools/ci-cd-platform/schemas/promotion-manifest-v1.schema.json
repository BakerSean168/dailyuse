{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoflow.dev/schemas/promotion-manifest-v1.schema.json",
  "type": "object",
  "required": ["kind", "version", "commit", "environment", "promotedBy", "artifacts", "digest"],
  "properties": {
    "kind": { "const": "promotion-manifest-v1" },
    "version": { "const": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "promotedBy": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest",
          "sourceManifestDigest",
          "path",
          "createdBy",
          "toolchain",
          "provenance"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceManifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "path": { "type": "string", "minLength": 1 },
          "createdBy": { "type": "string", "minLength": 1 },
          "toolchain": { "type": "object" },
          "provenance": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
