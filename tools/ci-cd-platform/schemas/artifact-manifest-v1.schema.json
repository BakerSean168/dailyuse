{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoflow.dev/schemas/artifact-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "kind",
    "version",
    "name",
    "commit",
    "digest",
    "sourceManifestDigest",
    "path",
    "createdBy",
    "toolchain",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "artifact-manifest-v1" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceManifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1 },
    "createdBy": { "type": "string", "minLength": 1 },
    "toolchain": { "type": "object" },
    "provenance": { "type": "object" },
    "entries": { "type": "array" }
  },
  "allOf": [
    {
      "if": { "properties": { "name": { "const": "api-runtime-closure" } } },
      "then": {
        "required": ["entries"],
        "properties": {
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "path"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "pattern": "^packages/.+/dist$" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
