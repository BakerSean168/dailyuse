{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoflow.dev/schemas/fault-injection-report-v1.schema.json",
  "type": "object",
  "required": ["kind", "version", "status", "scenarios", "provenance", "digest"],
  "properties": {
    "kind": { "const": "fault-injection-report-v1" },
    "version": { "const": 1 },
    "status": { "const": "passed" },
    "scenarios": { "type": "array", "minItems": 1 },
    "provenance": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
