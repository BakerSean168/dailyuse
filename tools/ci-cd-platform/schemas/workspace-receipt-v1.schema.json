{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoflow.dev/schemas/workspace-receipt-v1.schema.json",
  "type": "object",
  "required": [
    "kind",
    "version",
    "commit",
    "runner",
    "toolchain",
    "capabilities",
    "cache",
    "timing",
    "provenance",
    "digest"
  ],
  "properties": {
    "kind": { "const": "workspace-receipt-v1" },
    "version": { "const": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "runner": { "type": "object" },
    "toolchain": { "type": "object" },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "cache": { "type": "object" },
    "timing": { "type": "object" },
    "provenance": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
