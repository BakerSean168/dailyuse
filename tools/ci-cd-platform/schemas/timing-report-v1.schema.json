{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoflow.dev/schemas/timing-report-v1.schema.json",
  "type": "object",
  "required": [
    "kind",
    "version",
    "profile",
    "sampleCount",
    "samples",
    "metrics",
    "provenance",
    "digest"
  ],
  "properties": {
    "kind": { "const": "timing-report-v1" },
    "version": { "const": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "sampleCount": { "type": "integer", "minimum": 1 },
    "samples": { "type": "array", "minItems": 1 },
    "metrics": { "type": "object" },
    "provenance": { "type": "object" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
