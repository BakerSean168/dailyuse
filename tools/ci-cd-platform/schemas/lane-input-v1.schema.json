{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoflow.dev/schemas/lane-input-v1.schema.json",
  "type": "object",
  "required": [
    "kind",
    "version",
    "lane",
    "commit",
    "manifestDigest",
    "inputs",
    "outputs",
    "environment",
    "cache",
    "failurePolicy",
    "owner",
    "capabilities",
    "policy",
    "scope",
    "risk",
    "digest"
  ],
  "properties": {
    "kind": { "const": "lane-input-v1" },
    "version": { "const": 1 },
    "lane": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "environment": { "type": "object" },
    "cache": { "type": "object" },
    "failurePolicy": { "type": "object" },
    "owner": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "policy": { "type": "object" },
    "scope": { "type": "object" },
    "risk": { "type": "object" },
    "runId": { "type": ["string", "null"] },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
