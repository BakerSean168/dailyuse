{
  "name": "ci-cd-platform",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/ci-cd-platform",
  "tags": ["scope:tools", "type:platform", "layer:ci"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*"],
      "options": { "command": "node --test tools/ci-cd-platform/__tests__/*.test.mjs" }
    },
    "contract": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*"],
      "options": {
        "command": "node --test tools/ci-cd-platform/__tests__/contracts.test.mjs tools/ci-cd-platform/__tests__/risk.test.mjs"
      }
    },
    "schema": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/schemas/**/*", "{projectRoot}/schema-check.mjs"],
      "options": { "command": "node tools/ci-cd-platform/schema-check.mjs" }
    },
    "governance": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/.github/actions/**/*"
      ],
      "options": {
        "command": "node tools/ci-cd-platform/schema-check.mjs && node tools/ci-cd-platform/registry-check.mjs && node --test tools/ci-cd-platform/__tests__/*.test.mjs"
      }
    },
    "manifest": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/scope/delivery-manifest-v1.json"],
      "options": { "command": "node tools/ci-cd-platform/generate-delivery-manifest.mjs" }
    },
    "artifact": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/ci-cd-platform/__tests__/artifact-contract.test.mjs" }
    },
    "promotion": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/ci-cd-platform/__tests__/promotion.test.mjs" }
    },
    "failure-matrix": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*"],
      "options": { "command": "node tools/ci-cd-platform/__tests__/failure-matrix.test.mjs" }
    },
    "registry": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/lib/**/*",
        "{projectRoot}/registry-check.mjs",
        "{projectRoot}/schemas/lane-registry-v1.schema.json"
      ],
      "options": { "command": "node tools/ci-cd-platform/registry-check.mjs" }
    },
    "observation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/ci-cd-platform/observe-run.mjs"
      }
    }
  }
}
