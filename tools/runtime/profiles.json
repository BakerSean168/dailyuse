{
  "$schema": "./profiles.schema.json",
  "version": 1,
  "description": "Single source of truth for MemoFlow local runtime host ports and lane rules. Compose defaults, preflight, Playwright, and docs must not invent conflicting host ports.",
  "reservedHostPorts": {
    "3000": [
      "host-dev",
      "e2e"
    ],
    "5173": [
      "host-dev",
      "e2e"
    ],
    "5432": [
      "host-dev",
      "dev-infra"
    ],
    "5433": [
      "e2e",
      "test-infra"
    ],
    "6384": [
      "host-dev",
      "dev-infra"
    ],
    "8080": [
      "host-dev",
      "dev-infra"
    ],
    "8081": [
      "host-dev"
    ]
  },
  "profiles": {
    "host-dev": {
      "title": "Host development (hot reload)",
      "description": "Nx run-many for API+Web; docker:dev:up for infra only.",
      "commands": {
        "infra": "pnpm docker:dev:up",
        "app": "pnpm nx run-many -t serve --projects=api,web --parallel=2"
      },
      "ports": {
        "api": 3000,
        "web": 5173,
        "postgres": 5432,
        "redis": 6384,
        "powersync": 8080
      },
      "urls": {
        "api": "http://localhost:3000",
        "web": "http://localhost:5173",
        "powersync": "http://localhost:8080"
      },
      "mutexWith": [
        "local-docker"
      ]
    },
    "e2e": {
      "title": "Playwright core e2e",
      "description": "Playwright owns API dist + Vite. Requires test DB on 5433. Do not reuse Docker API on :3000.",
      "commands": {
        "infra": "pnpm docker:test:up",
        "app": "pnpm e2e"
      },
      "ports": {
        "api": 3000,
        "web": 5173,
        "postgres": 5433
      },
      "urls": {
        "api": "http://localhost:3000",
        "web": "http://127.0.0.1:5173"
      },
      "runtimeLane": "e2e",
      "mutexWith": [
        "local-docker"
      ]
    },
    "local-docker": {
      "title": "Local prod-like Docker stack",
      "description": "docker-compose.local.yml full stack. Host ports MUST stay isolated from host-dev/e2e.",
      "commands": {
        "app": "pnpm docker:local:up"
      },
      "ports": {
        "api": 20201,
        "web": 20200,
        "powersync": 20202,
        "postgres": 20210,
        "redis": 20211
      },
      "hostPortEnv": {
        "API_HOST_PORT": 20201,
        "WEB_HOST_PORT": 20200,
        "POWERSYNC_HOST_PORT": 20202,
        "POSTGRES_HOST_PORT": 20210,
        "REDIS_HOST_PORT": 20211
      },
      "urls": {
        "api": "http://localhost:20201",
        "web": "http://localhost:20200",
        "powersync": "http://localhost:20202"
      },
      "mutexWith": [
        "host-dev",
        "e2e"
      ]
    },
    "dev-infra": {
      "title": "Dev infrastructure only",
      "description": "docker compose --profile dev (postgres/redis/powersync).",
      "commands": {
        "infra": "pnpm docker:dev:up"
      },
      "ports": {
        "postgres": 5432,
        "redis": 6384,
        "powersync": 8080
      }
    },
    "test-infra": {
      "title": "Test infrastructure only",
      "description": "docker compose --profile test (e2e/integration DB).",
      "commands": {
        "infra": "pnpm docker:test:up"
      },
      "ports": {
        "postgres": 5433
      }
    }
  }
}
