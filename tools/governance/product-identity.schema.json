{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["displayName", "slug", "packageScope", "github"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "packageScope": {
      "type": "string",
      "pattern": "^@[a-z][a-z0-9-]*$"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
