{
  "version": 2,
  "description": "Workspace target baseline and exemption manifest for governance audit",
  "changelog": {
    "2": "Added exemption types (permanent/temporary) with owner and targetDate for temporary exemptions"
  },

  "projectCategories": {
    "app": {
      "description": "Deployable applications",
      "requiredTargets": ["build", "lint", "typecheck", "test"]
    },
    "runtime-lib": {
      "description": "Libraries with runtime code consumed by apps or other business libraries",
      "requiredTargets": ["build", "lint", "typecheck", "test"]
    },
    "ui-lib": {
      "description": "UI component and presentation libraries",
      "requiredTargets": ["build", "lint", "typecheck", "test"]
    },
    "tooling-lib": {
      "description": "Tooling, scaffolding, test helpers, config projects",
      "requiredTargets": ["build"]
    },
    "meta-project": {
      "description": "Root/workspace-level governance project",
      "requiredTargets": []
    }
  },

  "projectRules": {
    "daily-use": "meta-project",
    "web": "app",
    "desktop": "app",
    "mobile": "app",
    "api": "app",
    "ai-service": "app",
    "account": "runtime-lib",
    "ai": "runtime-lib",
    "authentication": "runtime-lib",
    "editor": "runtime-lib",
    "goal": "runtime-lib",
    "governance": "runtime-lib",
    "notification": "runtime-lib",
    "reminder": "runtime-lib",
    "schedule": "runtime-lib",
    "setting": "runtime-lib",
    "task": "runtime-lib",
    "domain-shared": "runtime-lib",
    "contracts": "runtime-lib",
    "scheduler-server": "runtime-lib",
    "repository": "runtime-lib",
    "database": "runtime-lib",
    "http-client": "runtime-lib",
    "ipc-client": "runtime-lib",
    "powersync-schema": "runtime-lib",
    "utils": "runtime-lib",
    "patterns": "runtime-lib",
    "app-vue": "ui-lib",
    "ui-vue-shadcn": "ui-lib",
    "ui-react-native": "ui-lib",
    "ui-core": "ui-lib",
    "app-react": "ui-lib",
    "dashboard": "ui-lib",
    "assets": "ui-lib",
    "@dailyuse/test-utils": "tooling-lib",
    "nx-test-system": "tooling-lib"
  },

  "exemptions": [
    {
      "project": "mobile",
      "target": "build",
      "type": "permanent",
      "reason": "React Native: build is handled by Expo/Metro bundler, not a standalone Nx build target"
    },
    {
      "project": "mobile",
      "target": "test",
      "type": "temporary",
      "reason": "Mobile test infrastructure not yet set up; Expo test runner integration pending",
      "owner": "repo-owner",
      "targetDate": "2026-Q3"
    },
    {
      "project": "database",
      "target": "test",
      "type": "temporary",
      "reason": "Infrastructure package: integration tests deferred; validated through downstream consumers",
      "owner": "repo-owner",
      "targetDate": "2026-Q3"
    },
    {
      "project": "http-client",
      "target": "test",
      "type": "temporary",
      "reason": "Infrastructure lib: tested via integration with consuming apps",
      "owner": "repo-owner",
      "targetDate": "2026-Q3"
    },
    {
      "project": "ipc-client",
      "target": "test",
      "type": "temporary",
      "reason": "Infrastructure lib: tested via desktop IPC test targets",
      "owner": "repo-owner",
      "targetDate": "2026-Q3"
    },
    {
      "project": "dashboard",
      "target": "test",
      "type": "temporary",
      "reason": "UI lib: component tests deferred; validated through app-vue integration",
      "owner": "repo-owner",
      "targetDate": "2026-Q3"
    },
    {
      "project": "ui-vue-shadcn",
      "target": "test",
      "type": "temporary",
      "reason": "UI component lib: third-party shadcn-vue primitives; component tests deferred",
      "owner": "repo-owner",
      "targetDate": "2026-Q4"
    },
    {
      "project": "app-react",
      "target": "build",
      "type": "permanent",
      "reason": "React lib: build handled by React Native bundler; no standalone tsup build"
    },
    {
      "project": "app-react",
      "target": "test",
      "type": "temporary",
      "reason": "React lib: test infrastructure not yet set up",
      "owner": "repo-owner",
      "targetDate": "2026-Q3"
    },
    {
      "project": "ui-react-native",
      "target": "build",
      "type": "permanent",
      "reason": "React Native lib: build handled by Expo/Metro bundler"
    },
    {
      "project": "ui-react-native",
      "target": "test",
      "type": "temporary",
      "reason": "React Native lib: test infrastructure not yet set up",
      "owner": "repo-owner",
      "targetDate": "2026-Q3"
    },
    {
      "project": "powersync-schema",
      "target": "test",
      "type": "permanent",
      "reason": "Schema definition lib: declarative schema with no business logic to test"
    },
    {
      "project": "assets",
      "target": "lint",
      "type": "permanent",
      "reason": "Static asset lib: no source code to lint; contains only image/font/media files"
    },
    {
      "project": "assets",
      "target": "typecheck",
      "type": "permanent",
      "reason": "Static asset lib: no TypeScript source to type-check"
    },
    {
      "project": "nx-test-system",
      "target": "build",
      "type": "permanent",
      "reason": "Nx plugin: consumed directly by Nx devkit at runtime; no separate build artifact needed"
    }
  ]
}
