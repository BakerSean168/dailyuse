{
  "name": "daily-use",
  "private": true,
  "author": {
    "name": "bakersean",
    "email": "lulouhao@stu.sicau.edu.cn"
  },
  "description": "Memoflow Monorepo - Full-stack productivity suite built with Vue 3, Express, and Nx",
  "version": "0.5.1",
  "type": "module",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "// ========== Quick Start ==========": "",
    "dev": "nx run-many -t serve --projects=api,web --parallel=2",
    "// ========== Development ==========": "",
    "dev:all": "nx run-many -t serve --projects=api,web,desktop --parallel=3",
    "dev:web:local": "nx serve web --configuration=local",
    "dev:web:staging": "nx serve web --configuration=staging",
    "// ========== Build ==========": "",
    "build": "nx run-many -t build --all",
    "build:api": "nx build api",
    "build:web": "nx build web",
    "build:desktop": "nx build desktop",
    "build:affected": "nx affected -t build",
    "build:packages": "nx run-many -t build --all --exclude=api,web,desktop",
    "// ========== Type Checking ==========": "",
    "typecheck": "nx run-many -t typecheck --all --parallel=5",
    "typecheck:api": "nx typecheck api",
    "typecheck:web": "nx typecheck web",
    "typecheck:desktop": "nx typecheck desktop",
    "typecheck:affected": "nx affected -t typecheck",
    "// ========== Testing ==========": "",
    "test": "nx run-many -t test --all",
    "test:affected": "nx affected -t test",
    "test:unit": "nx test task",
    "test:smoke": "nx test:smoke api",
    "test:integration": "nx test:integration task",
    "test:all": "nx run-many -t test --projects=task,api",
    "test:api": "nx test api",
    "test:web": "nx test web",
    "// ========== E2E Testing ==========": "",
    "e2e": "nx e2e web-e2e",
    "e2e:headed": "nx e2e web-e2e --headed",
    "e2e:debug": "nx e2e web-e2e --debug",
    "e2e:ui": "nx e2e web-e2e --ui",
    "// ========== Docker Database ==========": "",
    "docker:dev:up": "docker compose --profile dev up -d",
    "docker:dev:down": "docker compose --profile dev down",
    "docker:dev:logs": "docker compose --profile dev logs -f",
    "docker:dev:reset": "docker compose --profile dev down -v && docker compose --profile dev up -d",
    "docker:test:up": "docker compose --profile test up -d",
    "docker:test:down": "docker compose --profile test down",
    "docker:test:reset": "docker compose --profile test down && docker compose --profile test up -d",
    "docker:local:build-prep": "node ./tools/docker/local-compose.mjs build-prep",
    "docker:local:build-prep:rebuild": "node ./tools/docker/local-compose.mjs build-prep:rebuild",
    "docker:local:up": "node ./tools/docker/local-compose.mjs up",
    "docker:local:rebuild": "node ./tools/docker/local-compose.mjs rebuild",
    "docker:local:down": "node ./tools/docker/local-compose.mjs down",
    "docker:local:ps": "node ./tools/docker/local-compose.mjs ps",
    "docker:local:logs": "node ./tools/docker/local-compose.mjs logs",
    "docker:prod:build": "pwsh -File ./tools/docker/publish-images.ps1",
    "docker:prod:build:rebuild": "pwsh -File ./tools/docker/publish-images.ps1 -SkipNxCache",
    "docker:prod:push": "pwsh -File ./tools/docker/publish-images.ps1 -Push",
    "docker:prod:push:rebuild": "pwsh -File ./tools/docker/publish-images.ps1 -Push -SkipNxCache",
    "// ========== Code Quality ==========": "",
    "lint": "nx run-many -t lint --all --parallel=5",
    "lint:fix": "nx run-many -t lint --all --parallel=5 --fix",
    "lint:affected": "nx affected -t lint",
    "lint:api": "nx lint api",
    "lint:web": "nx lint web",
    "lint:desktop": "nx lint desktop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "// ========== Nx Utilities ==========": "",
    "graph": "nx graph",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "affected:typecheck": "nx affected -t typecheck",
    "affected": "nx affected",
    "// ========== Maintenance ==========": "",
    "clean": "nx reset",
    "clean:cache": "nx reset",
    "clean:deps": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean:dist": "nx run-many -t clean --all",
    "reset": "nx reset && pnpm clean:deps && pnpm install",
    "// ========== Package Management ==========": "",
    "install:all": "pnpm install",
    "update:deps": "pnpm update --latest --recursive",
    "check:deps": "pnpm outdated --recursive"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.80",
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "@dailyuse/contracts": "workspace:*",
    "@dailyuse/utils": "workspace:*",
    "@prisma/client": "^7.4.2",
    "@types/argon2": "0.15.4",
    "@types/multer": "2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vueuse/core": "14.1.0",
    "ai": "5.0.110",
    "argon2": "0.44.0",
    "cron-parser": "^5.4.0",
    "cronstrue": "^3.3.0",
    "dotenv-expand": "12.0.3",
    "echarts": "^6.0.0",
    "ioredis": "5.8.2",
    "mitt": "^3.0.1",
    "multer": "2.0.2",
    "node-cron": "^4.2.1",
    "node-schedule": "^2.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "vue-draggable-plus": "0.6.0",
    "vue-echarts": "^8.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nx/eslint": "22.5.3",
    "@nx/eslint-plugin": "22.5.3",
    "@nx/js": "22.5.3",
    "@nx/storybook": "22.5.3",
    "@nx/vite": "22.5.3",
    "@nx/vitest": "22.5.3",
    "@nx/web": "22.5.3",
    "@nx/workspace": "22.5.3",
    "@nxlv/python": "22.1.1",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/vue3": "^10.2.8",
    "@storybook/vue3-vite": "^10.2.8",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.18",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/vue": "^8.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.13.14",
    "@types/node-schedule": "^2.1.8",
    "@types/pg": "8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "@vue/test-utils": "^2.4.6",
    "eas-cli": "18.4.0",
    "electron": "39.2.6",
    "@electron/rebuild": "4.0.3",
    "esbuild-plugin-vue": "0.2.4",
    "eslint": "^9.0.0",
    "eslint-plugin-storybook": "10.2.8",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.3.0",
    "happy-dom": "^20.0.11",
    "jiti": "2.4.2",
    "jscpd": "4.0.5",
    "jsdom": "^27.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lodash-es": "^4.17.21",
    "madge": "8.0.0",
    "nx": "22.5.3",
    "prettier": "^3.0.0",
    "prisma": "^7.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sass-embedded": "^1.96.0",
    "shadcn-vue": "2.4.3",
    "storybook": "^10.2.8",
    "tailwindcss": "4.1.18",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.39.1",
    "verdaccio": "^6.0.5",
    "vite": "7.3.1",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "4.0.18",
    "vue-tsc": "3.1.8"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "22.13.14",
      "@electron/rebuild": "4.0.3",
      "vite": "^7.3.1",
      "jiti": "2.4.2"
    },
    "ignoredBuiltDependencies": [
      "@journeyapps/wa-sqlite",
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "electron-winstaller",
      "esbuild",
      "lzma-native",
      "maplibre-gl",
      "nx",
      "prisma",
      "vue-demi"
    ],
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "electron",
      "msw"
    ]
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "test": {
        "options": {
          "command": "vitest run --project=!task-integration"
        }
      }
    }
  }
}
