FROM scratch
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=dev
LABEL org.opencontainers.image.title="memoflow-staging-runtime"
LABEL org.opencontainers.image.description="MemoFlow canonical staging runtime contract"
LABEL org.opencontainers.image.created=$BUILD_DATE
LABEL org.opencontainers.image.revision=$VCS_REF
LABEL org.opencontainers.image.version=$VERSION
COPY deployment/staging/docker-compose.staging.yml /runtime/staging/docker-compose.staging.yml
COPY deployment/staging/staging-deploy-watch.sh /runtime/staging/staging-deploy-watch.sh
COPY deployment/staging/systemd /runtime/staging/systemd
COPY docker/powersync /runtime/staging/docker/powersync
COPY tools/ci-cd-platform/candidate-manifest.mjs /runtime/staging/tools/ci-cd-platform/candidate-manifest.mjs
COPY tools/ci-cd-platform/lib/contracts.mjs /runtime/staging/tools/ci-cd-platform/lib/contracts.mjs
COPY reports/candidate/candidate-set-v1.json /runtime/staging/candidate-set-v1.json
