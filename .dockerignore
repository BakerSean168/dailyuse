**/node_modules
# Residual 1335: do not ignore tools/build (tsup.base.config.ts is required by package builds in Docker).
# Only drop package/app `build` output dirs, not the tools/build sources.
packages/**/build
apps/**/build
**/coverage
**/.nx
**/dist-electron
**/.git
**/.github
**/.vscode
**/.idea
**/.venv
**/.uv-cache
**/.pytest_cache
**/.pytest-temp
**/.ruff_cache
**/.turbo
**/*.log
**/*.tmp
**/.env*
**/.DS_Store
**/Thumbs.db

coverage
docs
reports
tmp
nul
# Browser/E2E generated evidence is not part of product images.
apps/web/playwright*-report
apps/web/test-results*

# Delivery V3 runtime bundle embeds only the canonical candidate identity.
!reports/
reports/*
!reports/candidate/
reports/candidate/*
!reports/candidate/candidate-set-v1.json

# Delivery V3 production control bundle embeds only deterministic desired-state
# evidence plus PowerSync config from the exact Published Release source.
!reports/production/
reports/production/*
!reports/production/production-set-v1.json
!reports/production/production-set-v1.sha256
!reports/production/release-runtime/
reports/production/release-runtime/*
!reports/production/release-runtime/docker/
reports/production/release-runtime/docker/*
!reports/production/release-runtime/docker/powersync/
!reports/production/release-runtime/docker/powersync/**
