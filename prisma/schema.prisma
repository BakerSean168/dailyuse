// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Account Models
model account {
  id        String   @id @default(cuid())
  uuid      String   @unique
  username  String   @unique
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authSessions authSession[]
}

// Authentication Models  
model authCredential {
  id            String   @id @default(cuid())
  accountId     String
  credentialType String
  data          String   @db.Text
  metadata      String   @db.Text
  history       String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model authSession {
  id                    String   @id @default(cuid())
  uuid                  String   @unique
  accountId             String
  account               account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status                String   @default("ACTIVE")
  accessToken           String   @unique
  accessTokenExpiresAt  DateTime
  refreshToken          String   @unique
  refreshTokenExpiresAt DateTime
  device                String
  ipAddress             String?
  userAgent             String?
  history               String   @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastAccessedAt        DateTime
  revokedAt             DateTime?
}

// Repository Models
model repository {
  id        String   @id @default(cuid())
  uuid      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model resource {
  id        String   @id @default(cuid())
  uuid      String   @unique
  repositoryId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model folder {
  id        String   @id @default(cuid())
  uuid      String   @unique
  repositoryId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model repositoryStatistics {
  id        String   @id @default(cuid())
  uuid      String   @unique
  repositoryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Task Models
model task {
  id        String   @id @default(cuid())
  uuid      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model taskTemplate {
  id        String   @id @default(cuid())
  uuid      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model taskInstance {
  id        String   @id @default(cuid())
  uuid      String   @unique
  taskId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model taskDependency {
  id        String   @id @default(cuid())
  uuid      String   @unique
  fromTaskId String
  toTaskId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model taskStatistics {
  id        String   @id @default(cuid())
  uuid      String   @unique
  taskId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Goal Models
model goal {
  id        String   @id @default(cuid())
  uuid      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model goalKeyResult {
  id        String   @id @default(cuid())
  uuid      String   @unique
  goalId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snapshots keyResultWeightSnapshot[] @relation("keyResultWeightSnapshot")
}

model keyResultWeightSnapshot {
  id              String   @id @default(cuid())
  uuid            String   @unique
  keyResultId     String
  keyResult       goalKeyResult @relation("keyResultWeightSnapshot", fields: [keyResultId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Schedule Models
model schedule {
  id        String   @id @default(cuid())
  uuid      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model scheduleTask {
  id        String   @id @default(cuid())
  uuid      String   @unique
  scheduleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model scheduleExecution {
  id        String   @id @default(cuid())
  uuid      String   @unique
  scheduleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model scheduleStatistics {
  id        String   @id @default(cuid())
  uuid      String   @unique
  scheduleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reminder Models
model reminderTemplate {
  id        String   @id @default(cuid())
  uuid      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model reminderGroup {
  id        String   @id @default(cuid())
  uuid      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model reminderResponse {
  id        String   @id @default(cuid())
  uuid      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model reminderStatistics {
  id        String   @id @default(cuid())
  uuid      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notification Models
model notification {
  id        String   @id @default(cuid())
  uuid      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dashboard Models
model dashboardConfig {
  id        String   @id @default(cuid())
  uuid      String   @unique
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Setting Models
model setting {
  id        String   @id @default(cuid())
  uuid      String   @unique
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI Models
model aiConversation {
  id        String   @id @default(cuid())
  uuid      String   @unique
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model aiMessage {
  id             String   @id @default(cuid())
  uuid           String   @unique
  conversationId String
  createdAt      DateTime @default(now())
}

model aiGenerationTask {
  id        String   @id @default(cuid())
  uuid      String   @unique
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model aiProviderConfig {
  id        String   @id @default(cuid())
  uuid      String   @unique
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model aiUsageQuota {
  id        String   @id @default(cuid())
  uuid      String   @unique
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
